            <div>
              <h2 class="panel-title">Kredensial Login Administrator</h2>
              <p class="panel-desc">Perbarui username dan password untuk mengakses halaman Admin CMS ini.</p>
            </div>
          </div>
        `;
        let newUsername = DEFAULT_USERNAME;
        let newPassword = '';
        let confirmPassword = '';

        const authGrid = document.createElement('div');
        authGrid.className = 'form-grid-3';
        authGrid.append(
          createInputField('Username Baru', newUsername, (v) => (newUsername = v.trim())),
          createInputField('Password Baru (Min. 8 karakter)', '', (v) => (newPassword = v), { type: 'password' }),
          createInputField('Konfirmasi Password Baru', '', (v) => (confirmPassword = v), { type: 'password' })
        );

        const saveCredsBtn = document.createElement('button');
        saveCredsBtn.type = 'button';
        saveCredsBtn.className = 'btn-primary-ink';
        saveCredsBtn.style.alignSelf = 'flex-start';
        saveCredsBtn.innerHTML = '<i class="bi bi-key"></i> <span>Perbarui Kredensial Login</span>';
        saveCredsBtn.addEventListener('click', async () => {
          if (!newUsername || newPassword.length < 8) {
            showToast('Username wajib diisi dan password baru minimal 8 karakter.', 'error');
            return;
          }
          if (newPassword !== confirmPassword) {
            showToast('Konfirmasi password tidak cocok.', 'error');
            return;
          }
          const passwordHash = await sha256Hex(`${newUsername}:${newPassword}`);
          localStorage.setItem(STORAGE_AUTH_KEY, JSON.stringify({ username: newUsername, passwordHash }));
          setSessionAuthenticated(newUsername);
          showToast('Username dan password Admin berhasil diperbarui.', 'success');
        });

        panelAuth.append(authGrid, saveCredsBtn);
        workspaceCanvas.appendChild(panelAuth);

        // Panel 2: GitHub Direct Repository Sync
        const ghRaw = localStorage.getItem(STORAGE_GH_KEY);
        const ghConfig = ghRaw
          ? JSON.parse(ghRaw)
          : { owner: 'maksumsindet', repo: 'portofolio', branch: 'main', token: '' };

        const panelGh = document.createElement('section');
        panelGh.className = 'cms-panel';
        panelGh.innerHTML = `
          <div class="panel-header">
            <div>
              <h2 class="panel-title">Sinkronisasi Langsung ke Repositori GitHub</h2>
              <p class="panel-desc">Opsional: Masukkan GitHub Personal Access Token (Fine-Grained dengan izin Contents: Read dan Write) agar klik "Simpan Perubahan" di situs online langsung melakukan commit ke GitHub Pages.</p>
            </div>
          </div>
        `;
        const ghGrid = document.createElement('div');
        ghGrid.className = 'form-grid-3';
        ghGrid.append(
          createInputField('GitHub Owner', ghConfig.owner, (v) => (ghConfig.owner = v.trim())),
          createInputField('Nama Repositori', ghConfig.repo, (v) => (ghConfig.repo = v.trim())),
          createInputField('Branch Target', ghConfig.branch, (v) => (ghConfig.branch = v.trim())),
          createInputField(
            'GitHub Personal Access Token (ghp_... / github_pat_...)',
            ghConfig.token,
            (v) => (ghConfig.token = v.trim()),
            { type: 'password', fullWidth: true }
          )
        );
        const ghBtnRow = document.createElement('div');
        ghBtnRow.style.display = 'flex';
        ghBtnRow.style.gap = '10px';
        ghBtnRow.style.flexWrap = 'wrap';
        ghBtnRow.style.alignItems = 'center';

        const saveGhBtn = document.createElement('button');
        saveGhBtn.type = 'button';
        saveGhBtn.className = 'btn-primary-ink';
        saveGhBtn.innerHTML = '<i class="bi bi-floppy"></i> <span>Simpan Konfigurasi GitHub</span>';
        saveGhBtn.addEventListener('click', () => {
          localStorage.setItem(STORAGE_GH_KEY, JSON.stringify(ghConfig));
          checkEnvironmentMode();
          showToast('Konfigurasi GitHub Sync berhasil disimpan di browser ini.', 'success');
        });

        const createTokenBtn = document.createElement('a');
        createTokenBtn.href = 'https://github.com/settings/tokens/new?description=Maksum%20Portfolio%20Admin%20CMS&scopes=repo';
        createTokenBtn.target = '_blank';
        createTokenBtn.rel = 'noopener noreferrer';
        createTokenBtn.className = 'btn-secondary-plain';
        createTokenBtn.innerHTML = '<i class="bi bi-box-arrow-up-right"></i> <span>Buat Token di GitHub (Buka GitHub Settings)</span>';

        ghBtnRow.append(saveGhBtn, createTokenBtn);
        panelGh.append(ghGrid, ghBtnRow);
        workspaceCanvas.appendChild(panelGh);

        // Panel 3: Cadangan JSON (Export / Import / Reset)
        const panelBackup = document.createElement('section');
        panelBackup.className = 'cms-panel';
        panelBackup.innerHTML = `
          <div class="panel-header">
            <div>
              <h2 class="panel-title">Cadangan Data dan Pemulihan (JSON)</h2>
              <p class="panel-desc">Unduh seluruh data konten sebagai file <code>portfolioContent.json</code>, impor dari file, atau kembalikan ke data bawaan pabrik.</p>
            </div>
          </div>
        `;
        const btnRow = document.createElement('div');
        btnRow.style.display = 'flex';
        btnRow.style.gap = '12px';
        btnRow.style.flexWrap = 'wrap';

        const exportBtn = document.createElement('button');
        exportBtn.type = 'button';
        exportBtn.className = 'btn-secondary-plain';
        exportBtn.innerHTML = '<i class="bi bi-download"></i> <span>Unduh portfolioContent.json</span>';
        exportBtn.addEventListener('click', () => {
          const blob = new Blob([JSON.stringify(cmsData, null, 2) + '\n'], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'portfolioContent.json';
          a.click();
          URL.revokeObjectURL(url);
        });

        const importBtn = document.createElement('button');
        importBtn.type = 'button';
        importBtn.className = 'btn-secondary-plain';
        importBtn.innerHTML = '<i class="bi bi-upload"></i> <span>Impor File JSON</span>';
        importBtn.addEventListener('click', () => {
          hiddenJsonInput.value = '';
          hiddenJsonInput.click();
        });

        const resetBtn = document.createElement('button');
        resetBtn.type = 'button';
        resetBtn.className = 'btn-danger-plain';
        resetBtn.innerHTML = '<i class="bi bi-arrow-counterclockwise"></i> <span>Reset ke Konten Default (Pabrik)</span>';
        resetBtn.addEventListener('click', resetToDefaultContent);

        btnRow.append(exportBtn, importBtn, resetBtn);
        panelBackup.appendChild(btnRow);
        workspaceCanvas.appendChild(panelBackup);
      }

hiddenJsonInput?.addEventListener('change', () => {
        const file = hiddenJsonInput.files?.[0];
        if (!file) return;
        if (!file.name.toLowerCase().endsWith('.json')) {
          showToast('Tipe berkas ditolak: hanya menerima berkas .json', 'error');
          return;
        }
        if (file.size > 2 * 1024 * 1024) {
          showToast('Ukuran berkas JSON terlalu besar (maksimal 2 MB).', 'error');
          return;
        }
        const reader = new FileReader();
        reader.onload = () => {
          try {
            const parsed = JSON.parse(String(reader.result || '{}'));
            if (!parsed.personalInfo) throw new Error('Format JSON tidak memiliki properti personalInfo');
            cmsData = parsed;
            markDirty();
            updateSidebarCounts();
            renderActiveSection();
            showToast('File JSON berhasil diimpor. Klik "Simpan Perubahan" untuk menerapkan.', 'success');
          } catch (err: any) {
            showToast(`File JSON tidak valid: ${err?.message || String(err)}`, 'error');
          }
        };
        reader.readAsText(file);
      });

      // Navigasi Sidebar
      function navigateToSection(sec: string) {
        currentSection = sec;
        document.querySelectorAll('.sidebar-nav .nav-item').forEach((btn) => {
          if (btn.getAttribute('data-section') === sec) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
        sidebar.classList.remove('open');
        renderActiveSection();
      }

      document.querySelectorAll('.sidebar-nav .nav-item').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sec = btn.getAttribute('data-section') || 'overview';
          navigateToSection(sec);
        });
      });

      // Initialize
      switchViewAfterAuth();
    </script>
  </body>
</html>

