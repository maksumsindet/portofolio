      function renderActiveSection() {
        const meta = SECTION_META[currentSection] || SECTION_META.overview;
        sectionTitleEl.textContent = meta.title;
        sectionSubEl.textContent = meta.subtitle;
        workspaceCanvas.innerHTML = '';

        switch (currentSection) {
          case 'overview':
            renderOverviewSection();
            break;
          case 'profile':
            renderProfileSection();
            break;
          case 'about':
            renderAboutSection();
            break;
          case 'programs':
            renderProgramsSection();
            break;
          case 'experience':
            renderExperienceSection();
            break;
          case 'skills':
            renderSkillsSection();
            break;
          case 'education':
            renderEducationSection();
            break;
          case 'achievements':
            renderAchievementsSection();
            break;
          case 'media':
            renderMediaSection();
            break;
          case 'gallery':
            renderGallerySection();
            break;
          case 'settings':
            renderSettingsSection();
            break;
        }
      }

