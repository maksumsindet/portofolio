        }
        .workspace-topbar,
        .workspace-canvas {
          padding-left: 18px;
          padding-right: 18px;
        }
      }
    </style>

    <script>
      // =========================================================
      // SISTEM OTENTIKASI, PENYIMPANAN MULTI-MODE, dan EDITOR CMS
      // =========================================================
      const STORAGE_DATA_KEY = 'maksum_portfolio_cms_data';
      const STORAGE_AUTH_KEY = 'maksum_admin_credentials';
      const SESSION_AUTH_KEY = 'maksum_admin_session';
      const STORAGE_GH_KEY = 'maksum_admin_github_config';
      const STORAGE_RATE_KEY = 'maksum_admin_login_attempts';

      // Default SHA-256 hash untuk kredensial administrator awal
      const DEFAULT_USERNAME = 'maksum';
      const DEFAULT_PASS_HASH = '645527bc4c082dae36e2bc26578b259628c419a17f4f68468e1df9932958d915';
      const SESSION_TTL_MS = 2 * 60 * 60 * 1000; // Sesi kedaluwarsa otomatis setelah 2 jam

      async function sha256Hex(text: string): Promise<string> {
        const encoder = new TextEncoder();
        const data = encoder.encode(text);
        const hashBuffer = await crypto.subtle.digest('SHA-256', data);
        return Array.from(new Uint8Array(hashBuffer))
          .map((b) => b.toString(16).padStart(2, '0'))
          .join('');
      }

      const base = document.body.getAttribute('data-base-url') || '/portofolio/';
      const payloadEl = document.getElementById('initial-cms-payload');
      const defaultServerContent = payloadEl ? JSON.parse(payloadEl.textContent || '{}') : {};

      function loadWorkingContent(): any {
        const saved = localStorage.getItem(STORAGE_DATA_KEY);
        if (saved) {
          try {
            const parsed = JSON.parse(saved);
            // Validasi sinkronisasi: jika versi server berubah, hapus cache lokal usang
            if (parsed && parsed.version === defaultServerContent.version) {
              return parsed;
            }
          } catch {}
        }
        return JSON.parse(JSON.stringify(defaultServerContent));
      }

      let cmsData: any = loadWorkingContent();
      let currentSection = 'overview';
      let hasUnsavedChanges = false;
      let isLocalDevServer = false;

      // DOM References
      const loginView = document.getElementById('login-view') as HTMLElement;
      const adminApp = document.getElementById('admin-app') as HTMLElement;
      const loginForm = document.getElementById('login-form') as HTMLFormElement;
      const loginAlert = document.getElementById('login-alert') as HTMLElement;
      const loginUsernameInput = document.getElementById('login-username') as HTMLInputElement;
      const loginPasswordInput = document.getElementById('login-password') as HTMLInputElement;
      const togglePasswordBtn = document.getElementById('toggle-password-btn') as HTMLButtonElement;

      const workspaceCanvas = document.getElementById('workspace-canvas') as HTMLElement;
      const sectionTitleEl = document.getElementById('workspace-section-title') as HTMLElement;
      const sectionSubEl = document.getElementById('workspace-section-subtitle') as HTMLElement;
      const unsavedBadge = document.getElementById('unsaved-indicator') as HTMLElement;
      const savedTimestamp = document.getElementById('saved-timestamp') as HTMLElement;
      const globalToast = document.getElementById('global-toast') as HTMLElement;
      const saveAllBtn = document.getElementById('save-all-btn') as HTMLButtonElement;
      const resetDefaultBtn = document.getElementById('reset-default-btn') as HTMLButtonElement;
      const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement;
      const envBadge = document.getElementById('env-Connection-badge') as HTMLElement;
      const hiddenJsonInput = document.getElementById('hidden-json-import') as HTMLInputElement;
      const hiddenImageInput = document.getElementById('hidden-image-upload') as HTMLInputElement;
      const sidebar = document.getElementById('admin-sidebar') as HTMLElement;
      const mobileToggle = document.getElementById('mobile-sidebar-toggle') as HTMLButtonElement;

      let pendingImageCallback: ((uploadedPath: string) => void) | null = null;

      function showToast(message: string, type: 'success' | 'error' = 'success') {
        globalToast.hidden = false;
        globalToast.className = `toast-banner toast-${type}`;
        globalToast.textContent = message;
        setTimeout(() => {
          globalToast.hidden = true;
        }, 5000);
      }

      function markDirty() {
        hasUnsavedChanges = true;
        unsavedBadge.hidden = false;
        updateSidebarCounts();
      }

      function markClean(statusMsg?: string) {
        hasUnsavedChanges = false;
        unsavedBadge.hidden = true;
        const now = new Date();
        const timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
        savedTimestamp.textContent = statusMsg || `Tersimpan pukul ${timeStr}`;
      }

      function updateSidebarCounts() {
        const setCount = (id: string, val: number) => {
          const el = document.getElementById(id);
          if (el) el.textContent = String(val);
        };
        const progCount =
          (cmsData.programsShowcaseData?.programs || []).length +
          (cmsData.programsShowcaseData?.programCards || []).length;
        setCount('count-programs', progCount);
        setCount(
          'count-experience',
          (cmsData.experienceProgramAndWork || []).length + (cmsData.experienceOrganization || []).length
        );
        setCount('count-skills', (cmsData.skillsCategories || []).length);
        setCount('count-education', (cmsData.educationData || []).length);
        setCount('count-achievements', (cmsData.achievementsData || []).length);
        setCount('count-media', (cmsData.mediaData || []).length);
        setCount('count-gallery', (cmsData.documentaryPhotos || []).length);
      }

      async function checkEnvironmentMode() {
        try {
          const res = await fetch('/__admin_api/ping');
          if (res.ok) {
            const data = await res.json();
            if (data && data.ok) {
              isLocalDevServer = true;
              envBadge.textContent = 'Mode Lokal (File Sync Aktif)';
              return;
            }
          }
        } catch {}
        const ghRaw = localStorage.getItem(STORAGE_GH_KEY);
        if (ghRaw) {
          try {
            const gh = JSON.parse(ghRaw);
            if (gh.token) {
              envBadge.textContent = 'Mode GitHub Sync + Browser';
              return;
            }
          } catch {}
        }
        envBadge.textContent = 'Mode Browser Override';
      }

      // =========================================================
      // OTENTIKASI LOGIN dan RATE LIMITING
      // =========================================================
      async function getStoredCredentials() {
        const raw = localStorage.getItem(STORAGE_AUTH_KEY);
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            if (parsed.username && parsed.passwordHash) return parsed;
          } catch {}
        }
        return { username: DEFAULT_USERNAME, passwordHash: DEFAULT_PASS_HASH };
      }

      function isSessionAuthenticated(): boolean {
        const raw = sessionStorage.getItem(SESSION_AUTH_KEY);
        if (!raw) return false;
        try {
          const s = JSON.parse(raw);
          if (!s || !s.authenticated || !s.username || !s.loginAt) return false;
          if (Date.now() - Number(s.loginAt) > SESSION_TTL_MS) {
            sessionStorage.removeItem(SESSION_AUTH_KEY);
            return false;
          }
          return true;
        } catch {
          return false;
        }
      }

      function setSessionAuthenticated(username: string) {
        sessionStorage.setItem(
          SESSION_AUTH_KEY,
          JSON.stringify({ authenticated: true, username, loginAt: Date.now() })
        );
        const userLabel = document.getElementById('active-user-label');
        const userInit = document.getElementById('active-user-initial');
        if (userLabel) userLabel.textContent = username;
        if (userInit) userInit.textContent = username.charAt(0).toUpperCase();
      }

      function switchViewAfterAuth() {
        if (isSessionAuthenticated()) {
          loginView.hidden = true;
          adminApp.hidden = false;
          const s = JSON.parse(sessionStorage.getItem(SESSION_AUTH_KEY) || '{}');
          if (s.username) setSessionAuthenticated(s.username);
          checkEnvironmentMode();
          updateSidebarCounts();
          renderActiveSection();
        } else {
          loginView.hidden = false;
          adminApp.hidden = true;
        }
      }

      togglePasswordBtn?.addEventListener('click', () => {
        if (loginPasswordInput.type === 'password') {
          loginPasswordInput.type = 'text';
          togglePasswordBtn.textContent = 'Sembunyikan';
        } else {
          loginPasswordInput.type = 'password';
          togglePasswordBtn.textContent = 'Tampilkan';
        }
      });

      loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        loginAlert.hidden = true;

        const rateRaw = localStorage.getItem(STORAGE_RATE_KEY);
        const rate = rateRaw ? JSON.parse(rateRaw) : { count: 0, lockUntil: 0 };
        if (rate.lockUntil > Date.now()) {
          const waitSec = Math.ceil((rate.lockUntil - Date.now()) / 1000);
          loginAlert.textContent = `Terlalu banyak percobaan gagal. Silakan tunggu ${waitSec} detik lagi.`;
          loginAlert.hidden = false;
          return;
        }

        const username = loginUsernameInput.value.trim();
        const password = loginPasswordInput.value;

        if (!username || !password) {
          loginAlert.textContent = 'Username dan password wajib diisi.';
          loginAlert.hidden = false;
          return;
        }

        const creds = await getStoredCredentials();
        const inputHash = await sha256Hex(`${username}:${password}`);

        if (username === creds.username && inputHash === creds.passwordHash) {
          localStorage.removeItem(STORAGE_RATE_KEY);
          setSessionAuthenticated(username);
          loginPasswordInput.value = '';
          switchViewAfterAuth();
        } else {
          rate.count = (rate.count || 0) + 1;
          if (rate.count >= 5) {
            rate.lockUntil = Date.now() + 30000;
            rate.count = 0;
          }
          localStorage.setItem(STORAGE_RATE_KEY, JSON.stringify(rate));
          loginAlert.textContent = 'Username atau password tidak sesuai. Periksa kembali kredensial Anda.';
          loginAlert.hidden = false;
        }
      });

      logoutBtn?.addEventListener('click', () => {
        sessionStorage.removeItem(SESSION_AUTH_KEY);
        switchViewAfterAuth();
      });

      mobileToggle?.addEventListener('click', () => {
        sidebar.classList.toggle('open');
      });

      // =========================================================
      // PENYIMPANAN
      // =========================================================
      async function pushToGitHubIfConfigured(contentObj: any): Promise<string | null> {
        const ghRaw = localStorage.getItem(STORAGE_GH_KEY);
        if (!ghRaw) return null;
        let gh: any;
        try {
          gh = JSON.parse(ghRaw);
        } catch {
          return null;
        }
        if (!gh || !gh.token || !gh.owner || !gh.repo) return null;

        const branch = gh.branch || 'main';
        const filePath = 'src/data/portfolioContent.json';
        const apiUrl = `https://api.github.com/repos/${gh.owner}/${gh.repo}/contents/${filePath}`;

        const headers: Record<string, string> = {
          Accept: 'application/vnd.github+json',
          Authorization: `Bearer ${gh.token}`,
          'Content-Type': 'application/json'
        };

        const getRes = await fetch(`${apiUrl}?ref=${encodeURIComponent(branch)}`, { headers });
        let sha: string | undefined;
        if (getRes.ok) {
          const fileMeta = await getRes.json();
          sha = fileMeta.sha;
        }

        const jsonString = JSON.stringify(contentObj, null, 2) + '\n';
        const base64Content = btoa(unescape(encodeURIComponent(jsonString)));

        const putRes = await fetch(apiUrl, {
          method: 'PUT',
          headers,
          body: JSON.stringify({
            message: 'chore(cms): update konten portofolio via Admin Web',
            content: base64Content,
            branch,
            ...(sha ? { sha } : {})
          })
        });

        if (!putRes.ok) {
          const errText = await putRes.text();
          throw new Error(`GitHub API Error (${putRes.status}): ${errText}`);
        }
        return `Tersinkronisasi ke GitHub (${gh.owner}/${gh.repo}@${branch})`;
      }

      async function saveAllChanges() {
        saveAllBtn.disabled = true;
        const originalText = saveAllBtn.innerHTML;
        saveAllBtn.textContent = 'Menyimpan...';

        try {
          localStorage.setItem(STORAGE_DATA_KEY, JSON.stringify(cmsData));
          const messages: string[] = ['Browser Live Override'];

          if (isLocalDevServer) {
            const res = await fetch('/__admin_api/save', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CMS-Request': 'maksum-admin-v1'
              },
              body: JSON.stringify(cmsData)
            });
            if (res.ok) {
              messages.push('File Proyek Lokal (portfolioContent.json)');
            }
          }

          const ghMsg = await pushToGitHubIfConfigured(cmsData);
          if (ghMsg) messages.push(ghMsg);

          updateSidebarCounts();
          markClean();
          showToast(`Perubahan berhasil disimpan ke: ${messages.join(' + ')}`, 'success');
        } catch (err: any) {
          showToast(`Gagal menyimpan ke salah satu target: ${err?.message || String(err)}`, 'error');
        } finally {
          saveAllBtn.disabled = false;
          saveAllBtn.innerHTML = originalText;
        }
      }

      saveAllBtn?.addEventListener('click', saveAllChanges);

      async function resetToDefaultContent() {
        const confirmed = confirm(
          'Apakah Anda yakin ingin mengembalikan seluruh konten ke data default bawaan (pabrik)?\n\n' +
          '• Semua editan yang belum disimpan atau tersimpan di browser akan dikembalikan ke awal.\n' +
          '• File data di server lokal juga akan diselaraskan kembali ke konten default.\n\n' +
          'Klik OK untuk melanjutkan reset.'
        );
        if (!confirmed) return;

        localStorage.removeItem(STORAGE_DATA_KEY);
        cmsData = JSON.parse(JSON.stringify(defaultServerContent));

        if (isLocalDevServer) {
          try {
            await fetch('/__admin_api/save', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CMS-Request': 'maksum-admin-v1'
              },
              body: JSON.stringify(defaultServerContent)
            });
          } catch {}
        }

        updateSidebarCounts();
        markClean('Konten dikembalikan ke default');
        renderActiveSection();
        showToast('Seluruh konten berhasil di-reset dan dikembalikan ke kondisi default awal.', 'success');
      }

      resetDefaultBtn?.addEventListener('click', resetToDefaultContent);

      function triggerImageUpload(onSuccess: (path: string) => void) {
        pendingImageCallback = onSuccess;
        hiddenImageInput.value = '';
        hiddenImageInput.click();
      }

      hiddenImageInput?.addEventListener('change', () => {
        const file = hiddenImageInput.files?.[0];
        if (!file || !pendingImageCallback) return;

        const allowedMimes = ['image/jpeg', 'image/png', 'image/webp'];
        if (!allowedMimes.includes(file.type)) {
          showToast('Tipe file ditolak: hanya menerima gambar JPEG, PNG, atau WEBP (SVG diblokir demi keamanan XSS).', 'error');
          return;
        }
        if (file.size > 5 * 1024 * 1024) {
          showToast('Ukuran gambar terlalu besar (maksimal 5 MB).', 'error');
          return;
        }

        const reader = new FileReader();
        reader.onload = async () => {
          const base64Data = String(reader.result || '');
          if (isLocalDevServer) {
            try {
              const res = await fetch('/__admin_api/upload', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-CMS-Request': 'maksum-admin-v1'
                },
                body: JSON.stringify({
                  filename: file.name,
                  base64Data,
                  folder: 'assets/images/portfolio'
                })
              });
              if (res.ok) {
                const out = await res.json();
                if (out.ok && out.path) {
                  pendingImageCallback(out.path);
                  showToast(`Foto berhasil diunggah ke public/${out.path}`, 'success');
                  return;
                }
              }
            } catch {}
          }
          const ghRaw = localStorage.getItem(STORAGE_GH_KEY);
          if (!isLocalDevServer && ghRaw) {
            try {
              const gh = JSON.parse(ghRaw);
              if (gh && gh.token && gh.owner && gh.repo) {
                showToast('Mengunggah foto langsung ke repositori GitHub...', 'success');
                const cleanName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
                const targetFilePath = `public/assets/images/portfolio/${Date.now()}_${cleanName}`;
                const base64Pure = base64Data.split(',')[1];
                const putImgRes = await fetch(
                  `https://api.github.com/repos/${gh.owner}/${gh.repo}/contents/${targetFilePath}`,
                  {
                    method: 'PUT',
                    headers: {
                      Accept: 'application/vnd.github+json',
                      Authorization: `Bearer ${gh.token}`,
                      'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                      message: `chore(media): upload ${file.name} via Admin CMS`,
                      content: base64Pure,
                      branch: gh.branch || 'main'
                    })
                  }
                );
                if (putImgRes.ok) {
                  const relativePath = targetFilePath.replace('public/', '');
                  pendingImageCallback(relativePath);
                  markDirty();
                  showToast(`Foto berhasil diunggah langsung ke GitHub (${relativePath}). Klik Simpan Perubahan untuk mempublikasikan.`, 'success');
                  return;
                }
              }
            } catch (err) {
              console.warn('Direct GitHub upload failed, fallback to base64 preview', err);
            }
          }
          pendingImageCallback(base64Data);
          showToast('Foto dimuat sebagai pratinjau langsung (Simpan Perubahan untuk menerapkan).', 'success');
        };
        reader.readAsDataURL(file);
      });

      // =========================================================
      // HELPER PEMBUAT ELEMEN FORM
      // =========================================================
      function resolveImgSrc(src: string): string {
        if (!src) return '';
        const trimmed = String(src).trim();
        if (/^(javascript|vbscript):/i.test(trimmed)) return '';
        if (trimmed.startsWith('data:')) {
          return /^data:image\/(jpeg|jpg|png|webp);base64,/i.test(trimmed) ? trimmed : '';
        }
        if (trimmed.startsWith('https://') || trimmed.startsWith('http://') || trimmed.startsWith(base)) return trimmed;
        return `${base}${trimmed.replace(/^\/+/, '')}`;
      }

      function createInputField(
        label: string,
        value: string,
        onChange: (val: string) => void,
        options?: { placeholder?: string; type?: string; fullWidth?: boolean; hint?: string }
      ): HTMLElement {
        const wrap = document.createElement('div');
        wrap.className = `field-group${options?.fullWidth ? ' col-span-full' : ''}`;
        const lbl = document.createElement('label');
        lbl.className = 'field-label';
        lbl.textContent = label;
        const input = document.createElement('input');
        input.type = options?.type || 'text';
        input.className = 'field-input';
        input.value = value || '';
        if (options?.placeholder) input.placeholder = options.placeholder;
        input.addEventListener('input', () => {
          onChange(input.value);
          markDirty();
        });
        wrap.appendChild(lbl);
        wrap.appendChild(input);
        if (options?.hint) {
          const hint = document.createElement('span');
          hint.className = 'field-hint';
          hint.textContent = options.hint;
          wrap.appendChild(hint);
        }
        return wrap;
      }

      function createTextareaField(
        label: string,
        value: string,
        onChange: (val: string) => void,
        options?: { rows?: number; fullWidth?: boolean; hint?: string }
      ): HTMLElement {
        const wrap = document.createElement('div');
        wrap.className = `field-group${options?.fullWidth !== false ? ' col-span-full' : ''}`;
        const lbl = document.createElement('label');
        lbl.className = 'field-label';
        lbl.textContent = label;
        const textarea = document.createElement('textarea');
        textarea.className = 'field-textarea';
        if (options?.rows) textarea.rows = options.rows;
        textarea.value = value || '';
        textarea.addEventListener('input', () => {
          onChange(textarea.value);
          markDirty();
        });
        wrap.appendChild(lbl);
        wrap.appendChild(textarea);
        if (options?.hint) {
          const hint = document.createElement('span');
          hint.className = 'field-hint';
          hint.textContent = options.hint;
          wrap.appendChild(hint);
        }
        return wrap;
      }

      // =========================================================
      // RENDERER MODUL HALAMAN
      // =========================================================
      const SECTION_META: Record<string, { title: string; subtitle: string }> = {
        overview: {
          title: 'Ringkasan Data Portofolio',
          subtitle: 'Metrik konten aktif dan akses cepat ke seluruh bagian halaman utama.'
        },
        profile: {
          title: 'Profil dan Hero Utama',
          subtitle: 'Edit nama lengkap, foto profil utama, bio singkat, kontak, dan tautan sosial.'
        },
