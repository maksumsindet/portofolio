---
// src/pages/admin.astro
// Panel Admin CMS Portofolio Muhammad Dahron Mustofa Maksum (Security-Hardened)
import rawPortfolioContent from '../data/portfolioContent.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const initialDataJson = JSON.stringify(rawPortfolioContent);
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=()" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://cdn.jsdelivr.net; font-src 'self' https://cdn.fontshare.com https://cdn.jsdelivr.net data:; img-src 'self' data: https: blob:; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'self';"
    />
    <title>Admin CMS | Portofolio Muhammad Dahron Mustofa Maksum</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="shortcut icon" href={`${base}favicon.ico`} />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=gambarino@400&f[]=general-sans@400,500,600,700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body data-base-url={base} data-ui>
    <!-- Initial Server Content Payload -->
    <script type="application/json" id="initial-cms-payload" set:html={initialDataJson}></script>

    <!-- ==========================================
         1. LAYAR LOGIN KEAMANAN ADMIN
         ========================================== -->
    <main id="login-view" class="login-screen" aria-labelledby="login-heading">
      <div class="login-sheet">
        <div class="login-brand-row">
          <div class="brand-monogram" aria-hidden="true">M</div>
          <div class="brand-meta">
            <span class="brand-name">MAKSUM CMS</span>
            <span class="brand-scope">Manajemen Konten Portofolio</span>
          </div>
        </div>

        <h1 id="login-heading" class="login-title">Masuk ke Panel Admin</h1>
        <p class="login-desc">
          Gunakan kredensial administrator untuk mengelola konten profil, pengalaman, prestasi, liputan media, dan galeri dokumentasi pada halaman utama.
        </p>

        <div id="login-alert" class="alert-box alert-error" role="alert" hidden></div>

        <form id="login-form" class="login-form" novalidate>
          <div class="field-group">
            <label for="login-username" class="field-label">Username</label>
            <input
              type="text"
              id="login-username"
              name="username"
              class="field-input"
              autocomplete="username"
              placeholder="Masukkan username admin"
              required
            />
          </div>

          <div class="field-group">
            <div class="label-row">
              <label for="login-password" class="field-label">Password</label>
              <button
                type="button"
                id="toggle-password-btn"
                class="text-action-btn"
                aria-label="Tampilkan atau sembunyikan password"
              >
                Tampilkan
              </button>
            </div>
            <input
              type="password"
              id="login-password"
              name="password"
              class="field-input"
              autocomplete="current-password"
              placeholder="Masukkan password admin"
              required
            />
            <span class="field-hint">
              Otentikasi dilindungi hash kriptografi SHA-256 dan pembatasan percobaan brute-force.
            </span>
          </div>

          <div class="login-actions">
            <button type="submit" id="login-submit-btn" class="btn-primary-ink">
              <i class="bi bi-shield-lock" aria-hidden="true"></i>
              <span>Masuk ke Editor</span>
            </button>
          </div>
        </form>

        <div class="login-footer-row">
          <a href={base} class="back-public-link">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            <span>Kembali ke Halaman Portofolio Publik</span>
          </a>
        </div>
      </div>
    </main>

    <!-- ==========================================
         2. SHELL APLIKASI ADMIN CMS
         ========================================== -->
    <div id="admin-app" class="admin-shell" hidden>
      <!-- Sidebar Navigasi -->
      <aside class="admin-sidebar" id="admin-sidebar" aria-label="Menu Modul Konten">
        <div class="sidebar-top">
          <div class="sidebar-brand">
            <div class="brand-monogram" aria-hidden="true">M</div>
            <div class="brand-meta">
              <span class="brand-name">MAKSUM CMS</span>
              <span class="brand-scope" id="env-Connection-badge">Memeriksa mode...</span>
            </div>
          </div>
        </div>

        <nav class="sidebar-nav">
          <div class="nav-group-label">Ikhtisar</div>
          <button type="button" class="nav-item active" data-section="overview">
            <i class="bi bi-grid-1x2" aria-hidden="true"></i>
            <span>Ringkasan Data</span>
          </button>

          <div class="nav-group-label">Bagian Halaman Utama</div>
          <button type="button" class="nav-item" data-section="profile">
            <i class="bi bi-person-vcard" aria-hidden="true"></i>
            <span>Profil dan Hero Utama</span>
          </button>
          <button type="button" class="nav-item" data-section="about">
            <i class="bi bi-file-earmark-person" aria-hidden="true"></i>
            <span>Tentang Saya</span>
          </button>
          <button type="button" class="nav-item" data-section="programs">
            <i class="bi bi-layers" aria-hidden="true"></i>
            <span>Program dan Sorotan</span>
            <span class="nav-count" id="count-programs">6</span>
          </button>
          <button type="button" class="nav-item" data-section="experience">
            <i class="bi bi-briefcase" aria-hidden="true"></i>
            <span>Pengalaman dan Kerja</span>
            <span class="nav-count" id="count-experience">9</span>
          </button>
          <button type="button" class="nav-item" data-section="skills">
            <i class="bi bi-bar-chart-steps" aria-hidden="true"></i>
            <span>Keahlian dan Kompetensi</span>
            <span class="nav-count" id="count-skills">4</span>
          </button>
          <button type="button" class="nav-item" data-section="education">
            <i class="bi bi-mortarboard" aria-hidden="true"></i>
            <span>Pendidikan Formal</span>
            <span class="nav-count" id="count-education">4</span>
          </button>
          <button type="button" class="nav-item" data-section="achievements">
            <i class="bi bi-trophy" aria-hidden="true"></i>
            <span>Prestasi dan Sertifikasi</span>
            <span class="nav-count" id="count-achievements">10</span>
          </button>
          <button type="button" class="nav-item" data-section="media">
            <i class="bi bi-newspaper" aria-hidden="true"></i>
            <span>Liputan Media</span>
            <span class="nav-count" id="count-media">9</span>
          </button>
          <button type="button" class="nav-item" data-section="gallery">
            <i class="bi bi-images" aria-hidden="true"></i>
            <span>Galeri dan Instagram</span>
            <span class="nav-count" id="count-gallery">11</span>
          </button>

          <div class="nav-group-label">Sistem dan Keamanan</div>
          <button type="button" class="nav-item" data-section="settings">
            <i class="bi bi-shield-check" aria-hidden="true"></i>
            <span>Pengaturan dan GitHub</span>
          </button>
        </nav>

        <div class="sidebar-bottom">
          <div class="admin-user-row">
            <div class="user-initial" id="active-user-initial" aria-hidden="true">M</div>
            <div class="user-details">
              <span class="user-name" id="active-user-label">maksum</span>
              <span class="user-role">Administrator</span>
            </div>
            <button type="button" id="logout-btn" class="icon-btn" title="Keluar dari Admin" aria-label="Keluar dari Admin">
              <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </aside>

      <!-- Area Kerja Utama (White Sheet) -->
      <div class="admin-workspace">
        <!-- Top Bar -->
        <header class="workspace-topbar">
          <div class="topbar-left">
            <button type="button" id="mobile-sidebar-toggle" class="icon-btn mobile-only" aria-label="Buka menu navigasi">
              <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <div>
              <h1 id="workspace-section-title" class="workspace-h1">Ringkasan Data</h1>
              <p id="workspace-section-subtitle" class="workspace-sub">
                Status konten aktif dan metrik bagian halaman portofolio utama.
              </p>
            </div>
          </div>

          <div class="topbar-actions">
            <span id="unsaved-indicator" class="status-pill status-unsaved" hidden>
              Belum disimpan
            </span>
            <span id="saved-timestamp" class="status-timestamp">Siap diedit</span>

            <button type="button" id="reset-default-btn" class="btn-danger-plain" title="Kembalikan semua konten ke data default bawaan">
              <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
              <span>Reset Konten Default</span>
            </button>

            <a href={base} target="_blank" rel="noopener noreferrer" class="btn-secondary-plain">
              <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
              <span>Lihat Web Utama</span>
            </a>

            <button type="button" id="save-all-btn" class="btn-primary-ink">
              <i class="bi bi-check2-circle" aria-hidden="true"></i>
              <span>Simpan Perubahan</span>
            </button>
          </div>
        </header>

        <!-- Notifikasi Global -->
        <div id="global-toast" class="toast-banner" role="status" aria-live="polite" hidden></div>

        <!-- Kontainer Editor Dinamis -->
        <main id="workspace-canvas" class="workspace-canvas" tabindex="-1">
          <!-- Dirender secara dinamis oleh script di bawah -->
        </main>
      </div>
    </div>

    <!-- Input File Tersembunyi untuk Import JSON dan Upload Foto -->
    <input type="file" id="hidden-json-import" accept=".json,application/json" hidden />
    <input type="file" id="hidden-image-upload" accept="image/jpeg,image/png,image/webp" hidden />

    <style is:global>
      :root {
        --cms-ground: #F5F3EE;
        --cms-sheet: #FFFFFF;
        --cms-subtle: #FAF8F5;
        --cms-ink: #0B1931;
        --cms-ink-secondary: #526075;
        --cms-ink-muted: #7C889B;
        --cms-border: #E4E0D8;
        --cms-border-strong: #CBD2DC;
        --cms-accent: #C89B54;
        --cms-accent-ink: #8E682B;
        --cms-danger: #B42318;
        --cms-danger-bg: #FEF3F2;
        --cms-success: #067647;
        --cms-success-bg: #ECFDF3;
        --font-sans: 'General Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-serif: 'Gambarino', Georgia, serif;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body[data-ui] {
        font-family: var(--font-sans);
        background-color: var(--cms-ground);
        color: var(--cms-ink);
        font-size: 14px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }

      [hidden] {
        display: none !important;
      }

      .login-screen {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background-color: var(--cms-ground);
      }

      .login-sheet {
        width: 100%;
        max-width: 440px;
        background-color: var(--cms-sheet);
        border: 1px solid var(--cms-border);
        border-radius: 10px;
        padding: 36px 32px;
      }

      .login-brand-row,
      .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .login-brand-row {
        margin-bottom: 24px;
      }

      .brand-monogram {
        width: 34px;
        height: 34px;
        border-radius: 6px;
        background-color: var(--cms-ink);
        color: var(--cms-accent);
        font-family: var(--font-serif);
        font-size: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .brand-meta {
        display: flex;
        flex-direction: column;
      }

      .brand-name {
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 0.08em;
        color: var(--cms-ink);
      }

      .brand-scope {
        font-size: 12px;
        color: var(--cms-ink-secondary);
      }

      .login-title {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--cms-ink);
        margin-bottom: 8px;
      }

      .login-desc {
        font-size: 13.5px;
        color: var(--cms-ink-secondary);
        margin-bottom: 24px;
      }

      .login-form {
        display: flex;
        flex-direction: column;
        gap: 18px;
      }

      .field-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .field-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--cms-ink);
      }

      .field-hint {
        font-size: 12px;
        color: var(--cms-ink-secondary);
      }

      .field-input,
      .field-textarea,
      .field-select {
        width: 100%;
        padding: 9px 12px;
        font-family: var(--font-sans);
        font-size: 14px;
        color: var(--cms-ink);
        background-color: #FFFFFF;
        border: 1px solid var(--cms-border-strong);
        border-radius: 6px;
        transition: border-color 0.15s ease;
      }

      .field-input:focus,
      .field-textarea:focus,
      .field-select:focus {
        outline: 2px solid var(--cms-ink);
        outline-offset: 1px;
        border-color: var(--cms-ink);
      }

      .field-textarea {
        min-height: 92px;
        resize: vertical;
        line-height: 1.55;
      }

      .text-action-btn {
        background: none;
        border: none;
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 600;
        color: var(--cms-accent-ink);
        cursor: pointer;
        padding: 2px 4px;
      }

      .login-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 6px;
      }

      .btn-primary-ink {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background-color: var(--cms-ink);
        color: #FFFFFF;
        font-family: var(--font-sans);
        font-size: 13.5px;
        font-weight: 600;
        padding: 9px 16px;
        border-radius: 6px;
        border: 1px solid var(--cms-ink);
        cursor: pointer;
        text-decoration: none;
        transition: background-color 0.15s ease;
      }

      .btn-primary-ink:hover {
        background-color: #162B4D;
      }

      .btn-secondary-plain {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background-color: #FFFFFF;
        color: var(--cms-ink);
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 600;
        padding: 8px 14px;
        border-radius: 6px;
        border: 1px solid var(--cms-border-strong);
        cursor: pointer;
        text-decoration: none;
      }

      .btn-secondary-plain:hover {
        background-color: var(--cms-subtle);
      }

      .btn-danger-plain {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background-color: #FFFFFF;
        color: var(--cms-danger);
        font-family: var(--font-sans);
        font-size: 12.5px;
        font-weight: 600;
        padding: 6px 11px;
        border-radius: 6px;
        border: 1px solid #FDA29B;
        cursor: pointer;
      }

      .btn-danger-plain:hover {
        background-color: var(--cms-danger-bg);
      }

      .login-footer-row {
        margin-top: 24px;
        padding-top: 18px;
        border-top: 1px solid var(--cms-border);
      }

      .back-public-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 500;
        color: var(--cms-ink-secondary);
        text-decoration: none;
      }

      .back-public-link:hover {
        color: var(--cms-ink);
      }

      .alert-box {
        padding: 10px 12px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 16px;
      }

      .alert-error {
        background-color: var(--cms-danger-bg);
        color: var(--cms-danger);
        border: 1px solid #FDA29B;
      }

      .admin-shell {
        display: grid;
        grid-template-columns: 244px 1fr;
        min-height: 100vh;
        background-color: var(--cms-ground);
      }

      .admin-sidebar {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 18px 12px;
        background-color: var(--cms-ground);
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
      }

      .sidebar-top {
        padding: 4px 8px 16px;
        border-bottom: 1px solid var(--cms-border);
      }

      .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 12px 0;
        flex: 1;
      }

      .nav-group-label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--cms-ink-muted);
        padding: 12px 10px 4px;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 8px 10px;
        border: none;
        background: transparent;
        border-radius: 6px;
        font-family: var(--font-sans);
        font-size: 13.5px;
        font-weight: 500;
        color: var(--cms-ink-secondary);
        cursor: pointer;
        text-align: left;
      }

      .nav-item:hover {
        background-color: rgba(11, 25, 49, 0.05);
        color: var(--cms-ink);
      }

      .nav-item.active {
        background-color: #E7E2D8;
        color: var(--cms-ink);
        font-weight: 600;
      }

      .nav-count {
        margin-left: auto;
        font-size: 11.5px;
        font-variant-numeric: tabular-nums;
        color: var(--cms-ink-secondary);
        background-color: rgba(11, 25, 49, 0.07);
        padding: 1px 7px;
        border-radius: 999px;
      }

      .sidebar-bottom {
        padding-top: 12px;
        border-top: 1px solid var(--cms-border);
      }

      .admin-user-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 8px;
      }

      .user-initial {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background-color: var(--cms-ink);
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .user-details {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 0;
      }

      .user-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--cms-ink);
      }

      .user-role {
        font-size: 11.5px;
        color: var(--cms-ink-secondary);
      }

      .icon-btn {
        background: transparent;
        border: 1px solid transparent;
        border-radius: 6px;
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--cms-ink-secondary);
        cursor: pointer;
      }

      .icon-btn:hover {
        background-color: #E7E2D8;
        color: var(--cms-ink);
      }

      .admin-workspace {
        margin: 10px 10px 10px 0;
        background-color: var(--cms-sheet);
        border: 1px solid var(--cms-border);
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        min-width: 0;
      }

      .workspace-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 28px;
        border-bottom: 1px solid var(--cms-border);
        flex-wrap: wrap;
      }

      .topbar-left {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .workspace-h1 {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--cms-ink);
      }

      .workspace-sub {
        font-size: 13px;
        color: var(--cms-ink-secondary);
      }

      .topbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .status-pill {
        font-size: 12px;
        font-weight: 600;
        padding: 3px 9px;
        border-radius: 999px;
      }

      .status-unsaved {
        background-color: #FEF0C7;
        color: #93370D;
      }

      .status-timestamp {
        font-size: 12.5px;
        color: var(--cms-ink-secondary);
        font-variant-numeric: tabular-nums;
      }

      .toast-banner {
        margin: 16px 28px 0;
        padding: 11px 14px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
      }

      .toast-success {
        background-color: var(--cms-success-bg);
        color: var(--cms-success);
        border: 1px solid #ABEFC6;
      }

      .toast-error {
        background-color: var(--cms-danger-bg);
        color: var(--cms-danger);
        border: 1px solid #FDA29B;
      }

      .workspace-canvas {
        padding: 24px 28px 48px;
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .kpi-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border: 1px solid var(--cms-border);
        border-radius: 8px;
        background-color: var(--cms-subtle);
      }

      .kpi-cell {
        padding: 16px 20px;
        border-right: 1px solid var(--cms-border);
      }

      .kpi-cell:last-child {
        border-right: none;
      }

      .kpi-label {
        font-size: 12px;
        font-weight: 500;
        color: var(--cms-ink-secondary);
      }

      .kpi-value {
