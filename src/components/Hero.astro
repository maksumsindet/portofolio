---
// Hero.astro
// Executive Dark Hero matching the reference aesthetic:
// Seamless transparent cutout portrait, amber gold accents, pill badge, credibility ribbon, and floating spotlight cards
import { personalInfo } from '../data/portfolioData';

import rawPortfolioContent from '../data/portfolioContent.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

const heroBgSrc =
  (rawPortfolioContent as any)?.personalInfo?.heroBackgroundImage ||
  'assets/images/portfolio/segara-banner-sidoagung.jpg';
const heroBgImage = heroBgSrc.startsWith('http') || heroBgSrc.startsWith(base) || heroBgSrc.startsWith('data:')
  ? heroBgSrc
  : `${base}${heroBgSrc.replace(/^\/+/, '')}`;

const spotlightCards = [
  {
    tag: "KETUA TIM PELAKSANA | 224 KOLAM",
    title: "PPK ORMAWA SEGARA",
    desc: "Memimpin 14 mahasiswa lintas disiplin FMIPA UNY dalam koordinasi 5 pilar Sentra Gerak Agromina di Sidoagung, menaungi 224 kolam hingga meraih Juara 2 Nasional Abdidaya Ormawa.",
    image: `${base}assets/images/curated/spotlight-segara.jpg`,
    link: "#programs",
    linkLabel: "Jelajahi Kepemimpinan"
  },
  {
    tag: "PRESTASI TERTINGGI KEMDIKTISAINTEK",
    title: "TERBAIK 2 NASIONAL",
    desc: "Penerima Penghargaan Terbaik 2 Pemahaman Pemberdayaan Masyarakat Abdidaya Ormawa 2026 Kemdiktisaintek RI di UMI Makassar.",
    image: `${base}assets/images/curated/spotlight-abdidaya.jpg`,
    link: "#achievements",
    linkLabel: "Lihat Rekognisi"
  },
  {
    tag: "ANALISIS DATA dan SAINS",
    title: "STATISTIKA dan RISET",
    desc: "Presidium I Mukernas XIX IHMSI dan Kepala Departemen KPL KSI Mist FMIPA UNY dengan IPK 3.84 / 4.00.",
    image: `${base}assets/images/curated/spotlight-ihmsi.jpg`,
    link: "#experience",
    linkLabel: "Eksplorasi Jejak"
  }
];
const partners = [
  { name: "Universitas Negeri Yogyakarta", icon: "bi bi-mortarboard-fill" },
  { name: "Kemdiktisaintek RI", icon: "bi bi-award-fill" },
  { name: "Puspresnas Kemdiktisaintek", icon: "bi bi-trophy-fill" },
  { name: "BPTI Kemdiktisaintek", icon: "bi bi-stars" },
  { name: "Direktorat Belmawa", icon: "bi bi-compass-fill" },
  { name: "PPK Ormawa Nasional", icon: "bi bi-shield-check" },
  { name: "Pemkab Sleman", icon: "bi bi-geo-alt-fill" },
  { name: "Kalurahan Sidoagung", icon: "bi bi-building" },
  { name: "Gapokkan Segara Agung", icon: "bi bi-droplet-fill" },
  { name: "IHMSI Indonesia", icon: "bi bi-graph-up-arrow" },
  { name: "KSI Mist FMIPA UNY", icon: "bi bi-lightbulb-fill" },
  { name: "Dinas Kebudayaan DIY", icon: "bi bi-palette-fill" },
];

---

<section id="home" class="hero-section">
  <!-- Blurred Atmospheric Activity Background Layer -->
  <div class="hero-bg-backdrop" aria-hidden="true">
    <img 
      src={heroBgImage} 
      alt="Dokumentasi Kegiatan" 
      class="hero-bg-img"
      loading="eager"
      decoding="async"
    />
    <div class="hero-bg-overlay"></div>
  </div>

  <!-- Subtle Ambient Glow -->
  <div class="ambient-glow" aria-hidden="true"></div>

  <div class="container hero-container">
    <!-- Left Column: Content dan Identity -->
    <div class="hero-content fade-in">

      <h1 class="hero-title">
        Statistisi, <span class="highlight-text">Analis Data</span> dan Penggerak Inovasi Sosial
      </h1>

      <div class="hero-accent-bar" aria-hidden="true"></div>

      <p class="hero-description">
        Mahasiswa S1 Statistika UNY (IPK 3.84) dan <strong>Ketua Tim Pelaksana PPK Ormawa SEGARA</strong> yang mengombinasikan keahlian
        <strong>analisis data statistik</strong>, <strong>machine learning</strong>, serta kepemimpinan pemberdayaan
        masyarakat untuk menciptakan dampak nyata dan berkelanjutan.
      </p>

      <div class="hero-cta-group">
        <a href="#data-projects" class="btn btn-primary btn-lg">
          <i class="bi bi-cpu-fill"></i>
          <span>Eksplorasi Proyek Data</span>
        </a>
        <a href="#contact" class="btn btn-secondary btn-lg">
          <i class="bi bi-calendar2-check"></i>
          <span>Undang Maksum</span>
        </a>
      </div>

      <div class="hero-meta-row">
        <div class="meta-item">
          <i class="bi bi-geo-alt-fill"></i>
          <span>Bantul dan Yogyakarta</span>
        </div>
        <div class="meta-item">
          <i class="bi bi-mortarboard-fill"></i>
          <span>Universitas Negeri Yogyakarta (IPK 3.84)</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Seamless Cutout Portrait -->
    <div class="hero-visual fade-in">
      <div class="visual-wrapper">
        <div class="glow-backdrop" aria-hidden="true"></div>
        <picture>
          <source srcset={`${base}assets/images/profile-hero-transparent.webp`} type="image/webp" />
          <img
            src={`${base}assets/images/profile-hero-transparent.png`}
            alt="Muhammad Dahron Mustofa Maksum - Statistisi dan Analis Data"
            class="hero-image"
            id="heroImage"
            width="788"
            height="1024"
            fetchpriority="high"
          />
        </picture>
        <div class="floating-badge">
          <i class="bi bi-award-fill"></i>
          <div>
            <strong>Ketua Tim Pelaksana | Juara 2</strong>
            <span>Abdidaya Ormawa Kemdiktisaintek RI</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Credibility dan Partners Ribbon -->
  <div class="partners-ribbon-wrapper">
    <div class="container partners-container">
      <span class="partners-title">DIPERCAYA dan BERKOLABORASI:</span>
      <div class="partners-grid">
        {partners.map((partner) => (
          <div class="partner-badge">
            <i class={partner.icon}></i>
            <span>{partner.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 3 Floating Spotlight Cards (Signature Depth) -->
  <div class="container spotlight-container">
    <div class="floating-cards-row slide-up">
      {spotlightCards.map((card) => (
        <div class="spotlight-card">
          <div class="spotlight-img-wrap">
            <img src={card.image} alt={card.title} width="600" height="400" loading="lazy" />
          </div>
          <div class="spotlight-card-body">
            <span class="spotlight-tag">{card.tag}</span>
            <h2 class="spotlight-title">{card.title}</h2>
            <p class="spotlight-desc">{card.desc}</p>
            <a href={card.link} class="spotlight-link">
              <span>{card.linkLabel}</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background: var(--color-midnight-deep, #0B101B);
    color: #ffffff;
    padding-top: 4.5rem;
    padding-bottom: 5rem;
    overflow: hidden;
  }

  @media (max-width: 1024px) {
    .hero-section {
      padding-top: 2.25rem;
    }
  }

  /* Blurred Atmospheric Activity Background Layer */
  .hero-bg-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .hero-bg-img {
    position: absolute;
    top: -20px;
    left: -20px;
    width: calc(100% + 40px);
    height: calc(100% + 40px);
    object-fit: cover;
    object-position: center 30%;
    filter: blur(7px) brightness(0.68) saturate(1.15);
    transform: scale(1.04);
    user-select: none;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(90deg, rgba(5, 7, 12, 0.80) 0%, rgba(5, 7, 12, 0.52) 45%, rgba(5, 7, 12, 0.18) 75%, rgba(5, 7, 12, 0.50) 100%),
      linear-gradient(180deg, rgba(5, 7, 12, 0.30) 0%, rgba(5, 7, 12, 0.05) 35%, rgba(5, 7, 12, 0.65) 85%, #05070c 100%);
  }

  /* Ambient Glow Background */
  .ambient-glow {
    position: absolute;
    top: -120px;
    right: 5%;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: transparent;
    pointer-events: none;
    z-index: 1;
    filter: blur(50px);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.08fr 1fr;
    align-items: flex-end;
    gap: 3rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 2;
  }

  .hero-content {
    padding-bottom: 3.5rem;
  }

  
  /* Bold Typography */
  .hero-title {
    font-size: clamp(2.3rem, 4.4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .highlight-text {
    color: var(--color-gold);
    position: relative;
    font-style: normal;
  }

  /* Accent Bar */
  .hero-accent-bar {
    width: 54px;
    height: 3px;
    background: var(--color-gold);
    margin: 1.25rem 0 1.75rem;
    border-radius: 4px;
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--color-text-muted-light, #CBD5E1);
    line-height: 1.75;
    margin-bottom: 2.25rem;
    max-width: 600px;
  }

  .hero-description strong {
    color: #f8fafc;
    font-weight: 600;
  }

  /* CTA Buttons */
  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-bottom: 2.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s ease, color 0.25s ease;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--color-gold);
    color: var(--color-midnight-deep, #0B101B);
    border: 1px solid var(--color-gold);
    
  }

  .btn-primary:hover {
    background: var(--color-gold-hover);
    border-color: var(--color-gold-hover);
    transform: translateY(-2px);
    
    color: var(--color-midnight-deep, #0B101B);
  }

  .btn-secondary {
    background: rgba(15, 23, 42, 0.8);
    color: #f8fafc;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #0E1521;
  }

  .btn-secondary:hover {
    background: rgba(30, 41, 59, 0.9);
    border-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Meta Row */
  .hero-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.8rem;
    padding-top: 1.5rem;
    /* space over rule */
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-text-muted-light, #CBD5E1);
    font-size: 0.92rem;
  }

  .meta-item i {
    color: var(--color-gold);
    font-size: 1.05rem;
  }

  /* Right Column: Visual Wrapper dan Portrait */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    line-height: 0;
  }

  .visual-wrapper {
    position: relative;
    width: 100%;
    max-width: 580px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    line-height: 0;
  }

  .glow-backdrop {
    position: absolute;
    bottom: 8%;
    left: 50%;
    transform: translateX(-50%);
    width: 440px;
    height: 440px;
    border-radius: 50%;
    background: transparent;
    pointer-events: none;
    z-index: 1;
    filter: blur(40px);
  }

  .visual-wrapper picture {
    display: block;
    width: 100%;
    line-height: 0;
  }

  .hero-image {
    position: relative;
    z-index: 2;
    width: 100%;
    height: auto;
    max-height: 720px;
    object-fit: contain;
    display: block;
    vertical-align: bottom;
    border: none !important;
    border-radius: 0 !important;
    
    
    transition: transform 0.4s ease, filter 0.4s ease;
  }

  .hero-image:hover {
    transform: scale(1.02);
    
  }

  /* Floating Badge on Portrait */
  .floating-badge {
    position: absolute;
    bottom: 25px;
    left: 10px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: rgba(11, 16, 27, 0.9);
    background: #0B101B;
    
    border: 1px solid var(--color-gold-border);
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
    
    line-height: normal;
  }

  .floating-badge i {
    font-size: 1.55rem;
    color: var(--color-gold);
  }

  .floating-badge strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
  }

  .floating-badge span {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.75);
    display: block;
  }

  /* Credibility dan Partners Ribbon */
  .partners-ribbon-wrapper {
    position: relative;
    z-index: 3;
    background: rgba(8, 12, 20, 0.95);
    /* space over rule */
    /* space over rule */
    padding: 1.25rem 0;
    margin-top: 1rem;
  }

  .partners-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .partners-title {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-text-muted-light, #CBD5E1);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .partners-grid {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    flex-grow: 1;
  }

  .partner-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.04);
    padding: 0.45rem 1rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .partner-badge:hover {
    background: var(--color-gold-light);
    border-color: var(--color-gold-border);
    color: var(--color-gold);
  }

  .partner-badge i {
    color: var(--color-gold);
  }

  /* Spotlight Cards Section */
  .spotlight-container {
    max-width: 1280px;
    margin: 3.5rem auto 0;
    padding: 0 1.5rem;
    position: relative;
    z-index: 3;
  }

  .floating-cards-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .spotlight-card {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .spotlight-card:hover {
    transform: translateY(-6px);
    border-color: var(--color-gold-border);
    
  }

  .spotlight-img-wrap {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #1e293b;
  }

  .spotlight-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
  }

  .spotlight-card:hover .spotlight-img-wrap img {
    transform: scale(1.06);
  }

  .spotlight-card-body {
    padding: 1.8rem 1.6rem 1.6rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .spotlight-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-gold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
  }

  .spotlight-title {
    font-size: 1.25rem;
    color: #f8fafc;
    line-height: 1.25;
    margin-bottom: 0.65rem;
    font-weight: 700;
  }

  .spotlight-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-muted-light, #CBD5E1);
    margin-bottom: 1.4rem;
    flex-grow: 1;
    text-align: justify;
    text-justify: inter-word;
  }

  .spotlight-link {
    color: var(--color-gold);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s ease, gap 0.2s ease;
    margin-top: auto;
  }

  .spotlight-link:hover {
    color: var(--color-gold-hover);
    gap: 0.65rem;
  }

  /* Responsive Design */
  @media (max-width: 992px) {
    .hero-section {
      padding-top: 105px;
    }

    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3.5rem;
      align-items: center;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-bottom: 1rem;
    }

    .hero-description {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-cta-group {
      justify-content: center;
    }

    .hero-meta-row {
      justify-content: center;
    }

    .hero-visual {
      justify-content: center;
    }

    .visual-wrapper {
      max-width: 440px;
    }

    .floating-badge {
      left: 50%;
      transform: translateX(-50%);
      bottom: 20px;
      width: max-content;
    }

    .floating-cards-row {
      grid-template-columns: 1fr;
    }

    .partners-container {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }

    .partners-grid {
      justify-content: center;
    }
  }

  @media (max-width: 650px) {
    .hero-title {
      font-size: 2.15rem;
    }

    .hero-cta-group {
      flex-direction: column;
      width: 100%;
    }

    .hero-cta-group .btn {
      width: 100%;
    }

    .visual-wrapper {
      max-width: 320px;
    }
  }
</style>
