---
// Hero.astro
import { personalInfo } from '../data/portfolioData';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

const highlights = [
  {
    icon: "fas fa-award",
    title: "Terbaik 2 Nasional",
    subtitle: "Abdidaya Ormawa Kemdiktisaintek 2026",
  },
  {
    icon: "fas fa-graduation-cap",
    title: "IPK 3.84 / 4.00",
    subtitle: "S1 Statistika FMIPA UNY",
  },
  {
    icon: "fas fa-sitemap",
    title: "Ketua Tim Pelaksana",
    subtitle: "PPK Ormawa SEGARA (224 Kolam)",
  },
  {
    icon: "fas fa-gavel",
    title: "Presidium I Mukernas",
    subtitle: "Kajian Strategis IHMSI Indonesia",
  },
];
---

<section id="home" class="hero-section">
  <div class="hero-container">
    <!-- Left Column: Content -->
    <div class="hero-text-block fade-in">
      <h1 class="hero-headline">
        Wawasan Data Menggerakkan Perubahan Nyata
      </h1>
      <p class="hero-description">
        Menggabungkan keahlian <strong>Analisis Data Statistik</strong> & <strong>Machine Learning</strong> dengan <strong>Pemberdayaan Komunitas</strong> untuk menciptakan solusi nyata yang terukur, berdampak sosial, dan berkelanjutan.
      </p>
      
      <div class="hero-buttons">
        <a href="#about" class="btn-terracotta">
          <span>Kenal Lebih Dekat</span>
          <i class="fas fa-arrow-right"></i>
        </a>
        <a href="#programs" class="btn-outline-light">
          <span>Eksplorasi Program</span>
        </a>
      </div>

      <div class="hero-social">
        <span class="social-label">Terhubung:</span>
        <a href={personalInfo.social.email} class="social-pill" title="Email"><i class="fas fa-envelope"></i></a>
        <a href={personalInfo.social.linkedin} class="social-pill" title="LinkedIn" target="_blank" rel="noopener noreferrer"><i class="fab fa-linkedin-in"></i></a>
        <a href={personalInfo.social.instagram} class="social-pill" title="Instagram" target="_blank" rel="noopener noreferrer"><i class="fab fa-instagram"></i></a>
        <a href="https://github.com/maksumsindet" class="social-pill" title="GitHub" target="_blank" rel="noopener noreferrer"><i class="fab fa-github"></i></a>
      </div>
    </div>

    <!-- Right Column: Styled Portrait Arch -->
    <div class="hero-visual-block fade-in">
      <div class="script-badge">
        <span class="font-script">A Brighter Tomorrow</span>
      </div>

      <div class="arch-wrapper">
        <div class="arch-backdrop"></div>
        <div class="portrait-container">
          <img
            src={`${base}${personalInfo.profileImage}`}
            alt={personalInfo.name}
            class="portrait-img"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- 4-Column Highlights Banner -->
  <div class="hero-highlights-container">
    <div class="highlights-card slide-up">
      {highlights.map((item) => (
        <div class="highlight-col">
          <div class="highlight-icon-wrap">
            <i class={item.icon}></i>
          </div>
          <div class="highlight-info">
            <h3 class="highlight-title">{item.title}</h3>
            <p class="highlight-sub">{item.subtitle}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background-color: var(--color-burgundy);
    color: var(--color-text-light);
    padding: 9.5rem 6% 5.5rem;
    overflow: visible;
  }

  .hero-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 10;
  }

  /* Left Column */
  .hero-text-block {
    max-width: 680px;
  }

  .hero-headline {
    font-size: var(--step-display);
    line-height: 0.98;
    color: #ffffff;
    margin-bottom: 1.6rem;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .hero-description {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-text-muted-light);
    margin-bottom: 2.4rem;
    max-width: 600px;
  }

  .hero-description strong {
    color: #ffffff;
    font-weight: 600;
  }

  .hero-buttons {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .hero-social {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .social-label {
    font-size: 0.88rem;
    color: var(--color-text-muted-light);
    font-weight: 500;
    margin-right: 0.3rem;
  }

  .social-pill {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-text-muted-light);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 0.95rem;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, color 0.2s ease;
    border: none;
  }

  .social-pill:hover {
    background: var(--color-terracotta);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Visual Block */
  .hero-visual-block {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .script-badge {
    position: absolute;
    top: 5px;
    right: 15px;
    z-index: 15;
    transform: rotate(-8deg);
  }

  .script-badge span {
    font-size: 2.2rem;
    color: #ffffff;
    opacity: 0.88;
    white-space: nowrap;
  }

  .arch-wrapper {
    position: relative;
    width: 320px;
    height: 430px;
  }

  .arch-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-sage);
    border-radius: 160px 160px 24px 24px;
    z-index: 1;
  }

  .portrait-container {
    position: absolute;
    bottom: 0;
    left: 5%;
    width: 90%;
    height: 96%;
    z-index: 2;
    overflow: hidden;
    border-radius: 140px 140px 18px 18px;
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  /* Highlights Card Banner */
  .hero-highlights-container {
    max-width: 1240px;
    margin: 4.5rem auto -7.5rem;
    position: relative;
    z-index: 30;
  }

  .highlights-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 2.4rem 2.8rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
    border: none;
  }

  .highlight-col {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .highlight-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--color-cream-subtle);
    color: var(--color-burgundy);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, color 0.2s ease;
  }

  .highlight-col:hover .highlight-icon-wrap {
    background: var(--color-terracotta);
    color: #ffffff;
    transform: scale(1.08);
  }

  .highlight-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-text-dark);
    margin-bottom: 0.25rem;
    line-height: 1.15;
  }

  .highlight-sub {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  /* Responsive Adjustments */
  @media (max-width: 1100px) {
    .highlights-card {
      grid-template-columns: repeat(2, 1fr);
      padding: 2rem 2.2rem;
    }
  }

  @media (max-width: 850px) {
    .hero-section {
      padding: 7.5rem 5% 3.5rem;
    }
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3rem;
    }
    .hero-text-block {
      max-width: 100%;
    }
    .hero-buttons {
      justify-content: center;
    }
    .hero-social {
      justify-content: center;
    }
    .hero-highlights-container {
      margin-top: 3rem;
      margin-bottom: -5rem;
    }
    .highlights-card {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }
  }
</style>
