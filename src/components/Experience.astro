---
// Experience.astro
// Recreates "Pengalaman dan Kepemimpinan" with centered credential cards matching portfolio specifications
import { experienceProgramAndWork, experienceOrganization } from '../data/portfolioData';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

// Use all program and work experiences (including PPK Ormawa SEGARA dan ShopeeFood)
const professionalWork = experienceProgramAndWork;
---

<section id="experience" class="experience-section">
  <div class="experience-container">
    <div class="section-title fade-in">
      <h2>Pengalaman dan Kepemimpinan</h2>
      <p>
        Rekam jejak dedikasi dalam memimpin tim lintas disiplin, mengelola riset dan kajian strategis, serta mengorkestrasi program kemasyarakatan dari tingkat komunitas hingga nasional.
      </p>
    </div>

    <!-- Section 1: Pengalaman Organisasi (8 Centered Credential Cards) -->
    <div class="exp-group-wrap slide-up">
      <div class="group-header">
        <div class="group-icon-pill"><i class="bi bi-diagram-3"></i></div>
        <div>
          <h3 class="group-title">Pengalaman Organisasi</h3>
          <p class="group-subtitle">Perjalanan kepemimpinan dari inisiatif akar rumput dusun hingga panggung delegasi nasional.</p>
        </div>
      </div>

      <div class="org-cards-grid">
        {experienceOrganization.map((item) => (
          <div class="exp-card-org card-cream slide-up">
            <div class="org-logo-container">
              {item.logo ? (
                <img
                  src={`${base}${item.logo}`}
                  alt={item.organization}
                  class="org-logo-img"
                  width="48"
                  height="48"
                  loading="lazy"
                />
              ) : (
                <div class="org-icon-halo">
                  <i class={item.icon || "bi bi-people"}></i>
                </div>
              )}
            </div>

            <div class="org-header-meta">
              <span class="org-role-title">{item.role}</span>
              <h4 class="org-name-title">{item.organization}</h4>
              <span class="org-period-text">{item.period}</span>
              <div class="org-badge-slot">
                {item.badge && (
                  <span class="org-badge-pill">{item.badge}</span>
                )}
              </div>
            </div>

            <div class="org-card-divider"></div>

            <ul class="org-bullets-list">
              {item.responsibilities.map((res) => (
                <li>
                  <i class="bi bi-check2 org-check-icon"></i>
                  <span>{res}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Section 2: Pengalaman Kerja dan Operasional Profesional -->
    {professionalWork.length > 0 && (
      <div class="exp-group-wrap slide-up" style="margin-top: 5.5rem;">
        <div class="group-header">
          <div class="group-icon-pill"><i class="bi bi-briefcase"></i></div>
          <div>
            <h3 class="group-title">Pengalaman Profesional</h3>
            <p class="group-subtitle">Kepemimpinan eksekusi program nasional, dedikasi operasional lapangan, kepatuhan SOP tinggi, dan ketepatan waktu.</p>
          </div>
        </div>

        <div class="featured-cards-stack">
          {professionalWork.map((item) => (
            <div class="exp-card-featured card-cream">
              <div class="featured-top">
                <div class="logo-box">
                  {item.logo ? (
                    <img src={`${base}${item.logo}`} alt={item.organization} width="48" height="48" loading="lazy" />
                  ) : (
                    <i class={item.icon || "bi bi-briefcase"} style={`color: ${item.iconColor || 'var(--color-terracotta)'};`}></i>
                  )}
                </div>
                
                <div class="featured-meta">
                  <div class="meta-main">
                    <h4 class="exp-role">{item.role}</h4>
                    <h5 class="exp-org">{item.organization}</h5>
                    {item.location && <span class="exp-location"><i class="bi bi-geo-alt"></i> {item.location}</span>}
                  </div>
                  
                  <div class="meta-badge-wrap">
                    <span class="exp-date">{item.period}</span>
                    {item.badge && <span class="pill-badge-terracotta">{item.badge}</span>}
                  </div>
                </div>
              </div>

              {item.description && (
                <p class="featured-desc">{item.description}</p>
              )}

              <ul class="exp-bullets">
                {item.responsibilities.map((res) => (
                  <li>
                    <i class="bi bi-check-circle-fill bullet-icon"></i>
                    <span>{res}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .experience-section {
    background-color: var(--color-cream);
    padding: 6.5rem 6%;
    position: relative;
  }

  .experience-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .group-header {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 2.5rem;
  }

  .group-icon-pill {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-burgundy);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .group-title {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    color: var(--color-text-dark);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 0.2rem;
  }

  .group-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  /* Centered Organization Cards Grid */
  .org-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem;
  }

  .exp-card-org {
    padding: 2.2rem 1.6rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #ffffff;
    border-radius: 18px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    justify-content: flex-start;
  }

  .exp-card-org:hover {
    transform: translateY(-5px);
  }

  /* Centered Logo Container */
  .org-logo-container {
    height: 80px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.2rem;
  }

  .org-logo-img {
    max-height: 72px;
    max-width: 80%;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }

  .org-icon-halo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(200, 109, 86, 0.12);
    color: var(--color-terracotta);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
  }

  /* Centered Meta (Unified Height for Crisp Top-Alignment) */
  .org-header-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    min-height: 190px;
    justify-content: flex-start;
  }

  .org-role-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--color-terracotta);
    text-align: center;
    margin-bottom: 0.35rem;
    line-height: 1.3;
    min-height: 3.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .org-name-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-burgundy);
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: 0.4rem;
    min-height: 3.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .org-period-text {
    font-size: 0.82rem;
    font-weight: 600;
    color: #7a6e65;
    margin-bottom: 0.35rem;
    display: block;
  }

  .org-badge-slot {
    min-height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.2rem;
  }

  .org-badge-pill {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    background: rgba(200, 109, 86, 0.12);
    color: var(--color-terracotta);
  }

  .org-card-divider {
    width: 36px;
    height: 2px;
    background-color: rgba(200, 109, 86, 0.25);
    margin: 0.8rem auto 1.2rem;
  }

  /* Responsibilities List (Rata Atas) */
  .org-bullets-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-left: 0;
    margin: 0;
    width: 100%;
    margin-top: 0;
    flex-grow: 1;
  }

  .org-bullets-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #4a3e38;
  }

  .org-bullets-list li span:last-child {
    flex: 1;
    text-align: justify;
    text-justify: inter-word;
  }

  .org-check-icon {
    font-size: 0.95rem;
    color: var(--color-gold, #C5A880);
    margin-top: 2px;
    flex-shrink: 0;
  }

  /* Featured Work Experience */
  .featured-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
  }

  .exp-card-featured {
    padding: 2.6rem;
    background: #ffffff;
    border-radius: 18px;
  }

  .featured-top {
    display: flex;
    gap: 1.8rem;
    align-items: flex-start;
    margin-bottom: 1.4rem;
  }

  .logo-box {
    width: 76px;
    height: 76px;
    border-radius: 14px;
    background: var(--color-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem;
    flex-shrink: 0;
  }

  .logo-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .logo-box i {
    font-size: 2.2rem;
  }

  .featured-meta {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .exp-role {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    color: var(--color-text-dark);
    line-height: 1.25;
    margin-bottom: 0.25rem;
    font-weight: 400;
  }

  .exp-org {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .exp-location {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    display: block;
    margin-top: 0.3rem;
  }

  .meta-badge-wrap {
    text-align: right;
  }

  .exp-date {
    display: block;
    font-weight: 700;
    color: var(--color-terracotta);
    font-size: 0.92rem;
  }

  .pill-badge-terracotta {
    display: inline-block;
    background: rgba(200, 109, 86, 0.12);
    color: var(--color-terracotta);
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 700;
    margin-top: 0.4rem;
  }

  .featured-desc {
    font-size: 0.98rem;
    color: var(--color-text-secondary);
    padding: 1rem 1.4rem;
    background: var(--color-cream-subtle);
    border-radius: 8px;
    margin-bottom: 1.4rem;
    line-height: 1.6;
    text-align: justify;
    text-justify: inter-word;
  }

  .exp-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-left: 0;
    margin: 0;
  }

  .exp-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .exp-bullets li span {
    flex: 1;
    text-align: justify;
    text-justify: inter-word;
  }

  .bullet-icon {
    color: var(--color-sage-dark);
    margin-top: 5px;
    flex-shrink: 0;
    font-size: 0.9rem;
  }

  @media (max-width: 1200px) {
    .org-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 650px) {
    .featured-top {
      flex-direction: column;
      gap: 1rem;
    }
    .org-cards-grid {
      grid-template-columns: 1fr;
    }
    .exp-card-featured {
      padding: 1.8rem 1.4rem;
    }
  }
</style>
