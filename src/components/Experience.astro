---
// Experience.astro
import { experienceProgramAndWork, experienceOrganization } from '../data/portfolioData';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<section id="experience" class="experience section">
  <div class="section-title">
    <h2><span class="highlight">Pengalaman</span> & Kepemimpinan</h2>
  </div>

  <!-- Program Nasional & Pengalaman Kerja -->
  <div style="margin-bottom: 4rem;">
    <h3 style="text-align: center; color: var(--text-primary); font-size: 1.5rem; margin-bottom: 2rem;">
      <i class="fas fa-briefcase" style="color: var(--primary-color);"></i> Program Nasional & Profesional
    </h3>
    <div style="display: flex; flex-direction: column; gap: 2rem; max-width: 900px; margin: 0 auto;">
      {experienceProgramAndWork.map((item) => (
        <div class="glass-card slide-up" style="padding: 2rem;">
          <div style="display: flex; gap: 1.5rem; align-items: flex-start; flex-wrap: wrap;">
            <div style="width: 80px; height: 80px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: rgba(14, 165, 233, 0.08); border-radius: 12px; padding: 0.5rem;">
              {item.logo ? (
                <img
                  src={`${base}${item.logo}`}
                  alt={item.organization}
                  style="max-height: 100%; max-width: 100%; object-fit: contain;"
                  loading="lazy"
                />
              ) : (
                <i class={item.icon || "fas fa-briefcase"} style={`font-size: 2.2rem; color: ${item.iconColor || 'var(--primary-color)'};`}></i>
              )}
            </div>
            <div style="flex: 1; min-width: 260px;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
                <div>
                  <h3 style="font-size: 1.3rem; color: var(--accent-color); margin-bottom: 0.2rem;">{item.role}</h3>
                  <h4 style="font-size: 1.05rem; color: var(--text-primary); font-weight: 600;">{item.organization}</h4>
                  {item.location && <p style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.2rem;"><i class="fas fa-map-marker-alt"></i> {item.location}</p>}
                </div>
                <div style="text-align: right;">
                  <span class="date" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--primary-color);">{item.period}</span>
                  {item.badge && (
                    <span style="display: inline-block; margin-top: 0.4rem; padding: 0.25rem 0.65rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; background: rgba(249, 115, 22, 0.12); color: var(--accent-color); border: 1px solid rgba(249, 115, 22, 0.25);">
                      <i class="fas fa-award"></i> {item.badge}
                    </span>
                  )}
                </div>
              </div>
              {item.description && (
                <p style="font-size: 0.95rem; font-style: italic; color: var(--text-secondary); margin: 0.8rem 0; border-left: 3px solid var(--primary-color); padding-left: 0.8rem;">
                  {item.description}
                </p>
              )}
              <ul style="text-align: justify; margin-top: 1rem; color: var(--text-secondary); font-size: 0.95rem; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.5rem;">
                {item.responsibilities.map((res) => (
                  <li>{res}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Pengalaman Organisasi -->
  <div>
    <h3 style="text-align: center; color: var(--text-primary); font-size: 1.5rem; margin-bottom: 2rem;">
      <i class="fas fa-users" style="color: var(--primary-color);"></i> Organisasi & Kepemimpinan
    </h3>
    <div class="edu-grid">
      {experienceOrganization.map((exp) => (
        <div class="edu-card glass-card slide-up">
          <div class="icon" style="height: 100px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            {exp.logo ? (
              <img
                src={`${base}${exp.logo}`}
                alt={exp.organization}
                style="max-height: 85px; max-width: 100%; object-fit: contain; border-radius: 4px;"
                loading="lazy"
              />
            ) : (
              <i class={exp.icon || "fas fa-users"} style={`font-size: 2.5rem; color: ${exp.iconColor || 'var(--primary-color)'};`}></i>
            )}
          </div>
          <h3 style="font-size: 1.15rem; min-height: 2.8rem; display: flex; align-items: center; justify-content: center;">{exp.role}</h3>
          <h4 style="font-size: 0.95rem;">{exp.organization}</h4>
          <p class="date" style="font-weight: 500;">{exp.period}</p>
          <ul style="text-align: justify; margin-top: 1rem; color: var(--text-secondary); font-size: 0.9rem; padding-left: 1.2rem;">
            {exp.responsibilities.map((res) => (
              <li style="margin-bottom: 0.35rem;">{res}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
