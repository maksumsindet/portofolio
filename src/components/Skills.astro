---
// Skills.astro
import { skillsCategories } from '../data/portfolioData';
---

<section id="skills" class="skills-section">
  <div class="skills-container">
    <div class="section-title fade-in">
      <h2>Keahlian dan Kompetensi Teknis</h2>
      <p>
        Kombinasi kemampuan analitis kuantitatif, komputasi modern, serta keterampilan kepemimpinan dan komunikasi strategis.
      </p>
    </div>

    <div class="skills-categories-grid">
      {skillsCategories.map((cat) => (
        <div class="skill-category-card card-cream slide-up">
          <div class="cat-header">
            <div class="cat-icon-wrap">
              <i class={cat.icon}></i>
            </div>
            <h3 class="cat-title">{cat.category}</h3>
          </div>

          <div class="skill-chips-list">
            {cat.skills.map((skill) => (
              <div class="skill-chip">
                <div class="chip-icon">
                  <i class={skill.icon} style={skill.color ? `color: ${skill.color};` : ''}></i>
                </div>
                <div class="chip-text">
                  <span class="chip-name">{skill.name}</span>
                  {skill.details && <span class="chip-details">{skill.details}</span>}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-section {
    background-color: var(--color-cream);
    padding: 6.5rem 6%;
    position: relative;
  }

  .skills-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .skills-categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  .skill-category-card {
    padding: 2.8rem;
    display: flex;
    flex-direction: column;
  }

  .cat-header {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 2rem;
  }

  .cat-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(200, 109, 86, 0.12);
    color: var(--color-terracotta);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .cat-title {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    color: var(--color-text-dark);
    font-weight: 400;
  }

  .skill-chips-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .skill-chip {
    background: var(--color-cream-subtle);
    border: none;
    border-radius: 12px;
    padding: 0.95rem 1.1rem;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease;
  }

  .skill-chip:hover {
    background: #ffffff;
    transform: translateY(-2px);
  }

  .chip-icon {
    font-size: 1.25rem;
    margin-top: 2px;
    flex-shrink: 0;
  }

  .chip-text {
    display: flex;
    flex-direction: column;
  }

  .chip-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text-dark);
    line-height: 1.3;
  }

  .chip-details {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin-top: 0.2rem;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .skills-categories-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
