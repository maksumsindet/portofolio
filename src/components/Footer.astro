---
// Footer.astro
// Executive Bernstein theme footer with gold monogram and clean corporate typography
interface Props {
  name?: string;
}

const { name = "Muhammad Dahron Mustofa Maksum" } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <div class="footer-brand-wrap">
        <span class="footer-monogram">M.</span>
        <span class="footer-brand">MAKSUM</span>
      </div>
      <p class="footer-sub">S1 Statistika FMIPA UNY &bull; Data Analyst &bull; Social Impact Leadership</p>
    </div>

    <div class="footer-center">
      <p class="copyright-text">&copy; {currentYear} {name}. All Rights Reserved.</p>
    </div>

    <div class="footer-right">
      <a href="#home" class="back-to-top" title="Kembali ke Atas" aria-label="Kembali ke Atas">
        <span>Atas</span>
        <i class="bi bi-arrow-up"></i>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #080D16;
    padding: 2.8rem 6%;
    color: var(--color-text-muted-light);
    font-size: 0.9rem;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-brand-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background-color: var(--color-gold);
    color: #080D16;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 3px;
    line-height: 1;
  }

  .footer-brand {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: #ffffff;
  }

  .footer-sub {
    font-size: 0.84rem;
    color: var(--color-text-muted-light);
    margin-top: 0.35rem;
  }

  .copyright-text {
    color: var(--color-text-muted-light);
    font-size: 0.88rem;
  }

  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-gold);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    background: #141C2B;
    border: none;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, color 0.2s ease;
  }

  .back-to-top:hover {
    color: #080D16;
    background: var(--color-gold);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
      gap: 1.2rem;
    }
  }
</style>
