---
// Footer.astro
interface Props {
  name?: string;
}

const { name = "Muhammad Dahron Mustofa Maksum" } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <span class="footer-brand">MAKSUM<span class="dot">.</span></span>
      <p class="footer-sub">Statistika UNY &bull; Data Analyst &bull; Social Impact</p>
    </div>

    <div class="footer-center">
      <p class="copyright-text">&copy; {currentYear} {name}. All Rights Reserved.</p>
    </div>

    <div class="footer-right">
      <a href="#home" class="back-to-top" title="Kembali ke Atas">
        <span>Atas</span>
        <i class="fas fa-arrow-up"></i>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-burgundy-dark);
    padding: 2.8rem 6%;
    color: var(--color-text-muted-light);
    font-size: 0.9rem;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-brand {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: #ffffff;
  }

  .footer-brand .dot {
    color: var(--color-terracotta);
  }

  .footer-sub {
    font-size: 0.84rem;
    color: var(--color-text-muted-light);
    margin-top: 0.2rem;
  }

  .copyright-text {
    color: var(--color-text-muted-light);
    font-size: 0.88rem;
  }

  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted-light);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.08);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, color 0.2s ease;
  }

  .back-to-top:hover {
    color: #ffffff;
    background: var(--color-terracotta);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
      gap: 1.2rem;
    }
  }
</style>
