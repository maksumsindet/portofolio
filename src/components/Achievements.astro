---
// Achievements.astro
import { achievementsData } from '../data/portfolioData';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<section id="achievements" class="education section">
  <div class="section-title">
    <h2>Prestasi dan <span class="highlight">Sertifikat</span></h2>
  </div>
  <div class="edu-grid">
    {achievementsData.map((item) => (
      <div class="edu-card glass-card slide-up" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div class="icon" style="height: 100px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            {item.logo ? (
              <img
                src={`${base}${item.logo}`}
                alt={item.issuer}
                style="max-height: 85px; max-width: 100%; object-fit: contain; border-radius: 4px;"
                loading="lazy"
              />
            ) : (
              <i class={item.icon || "fas fa-award"} style={`font-size: 2.5rem; color: ${item.iconColor || 'var(--accent-color)'};`}></i>
            )}
          </div>
          <span style="display: inline-block; padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.75rem; font-weight: 600; background: rgba(14, 165, 233, 0.1); color: var(--primary-color); margin-bottom: 0.6rem;">
            {item.category}
          </span>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.4rem; min-height: 2.8rem; display: flex; align-items: center; justify-content: center;">
            {item.title}
          </h3>
          <h4 style="font-size: 0.95rem; color: var(--text-primary); margin-bottom: 0.4rem;">{item.issuer}</h4>
          <p class="date" style="font-weight: 500;">{item.year}</p>
        </div>
        {item.description && (
          <p style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.8rem; padding-top: 0.6rem; border-top: 1px dashed var(--card-border); text-align: center;">
            {item.description}
          </p>
        )}
      </div>
    ))}
  </div>
</section>
