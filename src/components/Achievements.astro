---
// Achievements.astro
// Recreates Achievements section in the executive Bernstein style with luxury gold badges and navy contrast
import { achievementsData } from '../data/portfolioData';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<section id="achievements" class="achievements-section">
  <div class="achievements-container">
    <div class="section-title fade-in">
      <div class="accent-lead-wrap" style="justify-content: center;">
        <span class="accent-rule"></span>
        <span class="lead-phrase">Rekam Jejak Prestasi dan Kejuaraan</span>
        <span class="accent-rule"></span>
      </div>
      <h2>
        <span class="headline-dark">PENGAKUAN dan</span>
        <span class="headline-gold">Prestasi Nasional</span>
      </h2>
      <p>
        Pengakuan tingkat nasional dan kompetensi teruji dalam inovasi pemberdayaan masyarakat, olimpiade matematika, komputasi data, dan kepemimpinan.
      </p>
    </div>

    <!-- Achievement Cards Grid -->
    <div class="achieve-grid slide-up">
      {achievementsData.map((item) => (
        <div class="achieve-card card-cream">
          <div class="achieve-top">
            <div class="achieve-icon-frame">
              {item.logo ? (
                <img src={`${base}${item.logo}`} alt={item.issuer} width="48" height="48" loading="lazy" />
              ) : (
                <i class={item.icon || "bi bi-trophy"} style={`color: ${item.iconColor || 'var(--color-gold)'};`}></i>
              )}
            </div>
            <div class="achieve-badges">
              <span class="badge-cat">{item.category}</span>
              <span class="badge-year">{item.year}</span>
            </div>
          </div>

          <h3 class="achieve-title">{item.title}</h3>
          <h4 class="achieve-issuer">{item.issuer}</h4>

          {item.description && (
            <p class="achieve-desc">{item.description}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .achievements-section {
    background-color: var(--color-cream);
    padding: 7rem 6%;
    position: relative;
  }

  .achievements-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .headline-dark {
    color: var(--color-text-dark);
    font-weight: 400;
  }

  .headline-gold {
    color: var(--color-gold);
    font-style: italic;
    font-weight: 400;
  }

  .achieve-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .achieve-card {
    padding: 2.2rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background: #FFFFFF;
    border-radius: 8px;
    border: none;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .achieve-card:hover {
    transform: translateY(-4px);
  }

  .achieve-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .achieve-icon-frame {
    width: 64px;
    height: 64px;
    border-radius: 6px;
    background: #F8FAFC;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    flex-shrink: 0;
  }

  .achieve-icon-frame img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .achieve-icon-frame i {
    font-size: 1.85rem;
  }

  .achieve-badges {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
  }

  .badge-cat {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-gold);
    background: #0B101B;
    border: none;
    padding: 0.2rem 0.65rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-year {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-secondary);
  }

  .achieve-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: var(--color-text-dark);
    margin-bottom: 0.4rem;
    line-height: 1.25;
    font-weight: 500;
  }

  .achieve-issuer {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    font-weight: 600;
    margin-bottom: 1.1rem;
  }

  .achieve-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-top: 0;
    text-align: justify;
    text-justify: inter-word;
  }

  @media (max-width: 1100px) {
    .achieve-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .achieve-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
