---
// DataProjects.astro
// Featured Technical Case Studies for Data Recruiters & Industry Evaluators
// Showcases: Problem Statement, Dataset/Tech Stack, Algorithms/Methodology, Quantified Impact Metrics, and Artifact Links
import { dataProjects } from '../data/portfolioData';

const projects = dataProjects?.projects || [];
---

<section id="data-projects" class="data-projects-section">
  <!-- Subtle background glow -->
  <div class="section-glow" aria-hidden="true"></div>

  <div class="container section-container">
    <!-- Section Header -->
    <div class="section-header fade-in">
      <div class="section-kicker">
        <i class="bi bi-cpu-fill"></i>
        <span>BUKTI TEKNIS & ANALITIK DATA</span>
      </div>
      <h2 class="section-title">
        Studi Kasus Proyek <span class="highlight-text">Data & Analisis</span>
      </h2>
      <div class="title-accent-bar" aria-hidden="true"></div>
      <p class="section-subtitle">
        {dataProjects?.sectionSubtitle || "Penerapan metodologi statistika terapan, machine learning, dan arsitektur sistem informasi untuk memecahkan problem riil mulai dari rantai pasok akuakultur pedesaan hingga advokasi kebijakan publik nasional."}
      </p>
    </div>

    <!-- Case Studies Cards Container -->
    <div class="case-studies-grid">
      {projects.map((proj, idx) => (
        <article class="case-card slide-up" id={proj.id} style={`animation-delay: ${idx * 0.15}s;`}>
          <!-- Card Header / Meta -->
          <div class="card-meta-row">
            <div class="badge-cluster">
              <span class="category-pill">
                <i class="bi bi-diagram-3-fill"></i>
                {proj.category}
              </span>
              <span class="status-pill">
                <span class="live-dot" aria-hidden="true"></span>
                {proj.badge}
              </span>
            </div>
            <div class="partner-meta">
              <i class="bi bi-calendar3"></i>
              <span>{proj.period}</span>
            </div>
          </div>

          <!-- Main Title & Context -->
          <div class="card-title-block">
            <h3 class="project-title">{proj.title}</h3>
            <p class="project-subtitle">{proj.subtitle}</p>
            <div class="project-partner">
              <i class="bi bi-building-check"></i>
              <span>{proj.partner}</span>
            </div>
          </div>

          <!-- 3-Pillar Technical Breakdown -->
          <div class="case-body-grid">
            <!-- Problem Column -->
            <div class="breakdown-col problem-col">
              <div class="col-heading">
                <i class="bi bi-exclamation-octagon-fill"></i>
                <h4>Tantangan & Masalah</h4>
              </div>
              <p>{proj.problem}</p>
            </div>

            <!-- Methodology Column -->
            <div class="breakdown-col method-col">
              <div class="col-heading">
                <i class="bi bi-gear-wide-connected"></i>
                <h4>Metodologi & Solusi Teknis</h4>
              </div>
              <p>{proj.methodology}</p>
            </div>

            <!-- Impact & Metrics Column -->
            <div class="breakdown-col metrics-col">
              <div class="col-heading">
                <i class="bi bi-graph-up-arrow"></i>
                <h4>Metrik Hasil & Dampak</h4>
              </div>
              <div class="metrics-boxes-grid">
                {proj.metrics.map((m) => (
                  <div class="metric-box">
                    <span class="metric-val">{m.value}</span>
                    <span class="metric-lbl">{m.label}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Card Footer: Tech Stack Chips & Action Links -->
          <div class="card-footer-row">
            <div class="tech-stack-wrap">
              <span class="stack-label">Tech Stack:</span>
              <div class="tech-chips">
                {proj.techStack.map((tech) => (
                  <span class="tech-chip">
                    <i class="bi bi-check2"></i>
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <div class="card-actions-wrap">
              {proj.githubUrl && (
                <a
                  href={proj.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="action-btn action-github"
                  aria-label="Lihat Kode di GitHub"
                >
                  <i class="bi bi-github"></i>
                  <span>GitHub</span>
                </a>
              )}
              {proj.docsUrl && (
                <a
                  href={proj.docsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="action-btn action-docs"
                  aria-label="Lihat Dokumen Riset di Google Drive"
                >
                  <i class="bi bi-folder2-open"></i>
                  <span>Dokumen Riset</span>
                </a>
              )}
              {proj.demoUrl && (
                <a
                  href={proj.demoUrl}
                  class="action-btn action-explore"
                  aria-label="Eksplorasi Program Terkait"
                >
                  <i class="bi bi-arrow-up-right-square"></i>
                  <span>Detail Program</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .data-projects-section {
    position: relative;
    background-color: var(--color-charcoal, #141416);
    color: var(--color-white, #ffffff);
    padding: 7rem 6%;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .section-glow {
    position: absolute;
    top: 15%;
    left: 50%;
    transform: translateX(-50%);
    width: 650px;
    height: 380px;
    background: radial-gradient(circle, rgba(200, 157, 86, 0.12) 0%, rgba(20, 20, 22, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  .section-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Header */
  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 4.5rem;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    background: rgba(200, 157, 86, 0.12);
    border: 1px solid rgba(200, 157, 86, 0.35);
    color: var(--color-gold, #c89d56);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-family: var(--font-serif, "Playfair Display", Georgia, serif);
    font-size: clamp(2rem, 4vw, 2.85rem);
    font-weight: 700;
    line-height: 1.22;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .highlight-text {
    color: var(--color-gold, #c89d56);
    font-style: italic;
  }

  .title-accent-bar {
    width: 64px;
    height: 3px;
    background: linear-gradient(90deg, #c89d56, #e5a93c);
    margin: 0 auto 1.25rem;
    border-radius: 2px;
  }

  .section-subtitle {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Grid of Cards */
  .case-studies-grid {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  .case-card {
    background: rgba(26, 26, 30, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 2.5rem;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease, box-shadow 0.35s ease;
    position: relative;
    overflow: hidden;
  }

  .case-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(180deg, var(--color-gold, #c89d56), transparent);
    opacity: 0.7;
    transition: width 0.3s ease, opacity 0.3s ease;
  }

  .case-card:hover {
    transform: translateY(-4px);
    border-color: rgba(200, 157, 86, 0.4);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.45);
  }

  .case-card:hover::before {
    width: 6px;
    opacity: 1;
  }

  /* Card Meta Row */
  .card-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .badge-cluster {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(200, 157, 86, 0.15);
    border: 1px solid rgba(200, 157, 86, 0.3);
    color: var(--color-gold, #c89d56);
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
    display: inline-block;
  }

  .partner-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
  }

  /* Title Block */
  .card-title-block {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .project-title {
    font-family: var(--font-serif, "Playfair Display", Georgia, serif);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    margin-bottom: 0.4rem;
  }

  .project-subtitle {
    font-size: 1.02rem;
    color: rgba(200, 157, 86, 0.95);
    font-weight: 500;
    margin-bottom: 0.65rem;
  }

  .project-partner {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .project-partner i {
    color: var(--color-gold, #c89d56);
  }

  /* 3-Column Breakdown */
  .case-body-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.15fr;
    gap: 1.75rem;
    margin-bottom: 2.25rem;
  }

  .breakdown-col {
    background: rgba(18, 18, 20, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .col-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .col-heading i {
    font-size: 1.15rem;
  }

  .col-heading h4 {
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0;
  }

  .problem-col .col-heading i {
    color: #f87171;
  }
  .problem-col .col-heading h4 {
    color: #fca5a5;
  }

  .method-col .col-heading i {
    color: #60a5fa;
  }
  .method-col .col-heading h4 {
    color: #93c5fd;
  }

  .metrics-col .col-heading i {
    color: var(--color-gold, #c89d56);
  }
  .metrics-col .col-heading h4 {
    color: #fde68a;
  }

  .breakdown-col p {
    font-size: 0.92rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }

  /* Metrics Boxes Grid */
  .metrics-boxes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
    height: 100%;
  }

  .metric-box {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(200, 157, 86, 0.25);
    border-radius: 8px;
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .metric-box:hover {
    background: rgba(200, 157, 86, 0.08);
    border-color: rgba(200, 157, 86, 0.45);
  }

  .metric-val {
    font-family: var(--font-serif, "Playfair Display", Georgia, serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-gold, #c89d56);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .metric-lbl {
    font-size: 0.74rem;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
  }

  /* Card Footer */
  .card-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tech-stack-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .stack-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
    padding: 0.28rem 0.65rem;
    border-radius: 5px;
    font-size: 0.78rem;
    font-family: "Courier New", monospace, sans-serif;
  }

  .tech-chip i {
    color: var(--color-gold, #c89d56);
    font-size: 0.85rem;
  }

  .card-actions-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.05rem;
    border-radius: 8px;
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .action-github {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }
  .action-github:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.35);
  }

  .action-docs {
    background: rgba(200, 157, 86, 0.12);
    color: var(--color-gold, #c89d56);
    border: 1px solid rgba(200, 157, 86, 0.35);
  }
  .action-docs:hover {
    background: rgba(200, 157, 86, 0.25);
    color: #ffffff;
    border-color: var(--color-gold, #c89d56);
  }

  .action-explore {
    background: transparent;
    color: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .action-explore:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .case-body-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .metrics-boxes-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 768px) {
    .data-projects-section {
      padding: 5rem 5%;
    }

    .case-card {
      padding: 1.75rem;
    }

    .metrics-boxes-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .card-footer-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .card-actions-wrap {
      width: 100%;
    }

    .action-btn {
      flex: 1;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .metrics-boxes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

