---
// DataProjects.astro
// Showcase Berkas Proyek Data & Riset Akademik Resmi (Sesuai Arsip Google Drive)
// Format: Single Dossier Card Bersih Tanpa Foto, Fokus pada Naskah Resmi, Metrik Nyata, dan Tautan Berkas Drive
import { dataProjects } from '../data/portfolioData';

const projects = dataProjects?.projects || [];

const categoryThemes: Record<string, { text: string; bg: string; border: string; icon: string }> = {
  'agrialert-satria-data': {
    text: '#38bdf8',
    bg: 'rgba(56, 189, 248, 0.12)',
    border: 'rgba(56, 189, 248, 0.3)',
    icon: 'bi-broadcast-pin'
  },
  'gemastik-lda-umkm': {
    text: '#a78bfa',
    bg: 'rgba(167, 139, 250, 0.12)',
    border: 'rgba(167, 139, 250, 0.3)',
    icon: 'bi-diagram-3-fill'
  },
  'pkm-rsh-ai-literacy': {
    text: '#fb923c',
    bg: 'rgba(251, 146, 60, 0.12)',
    border: 'rgba(251, 146, 60, 0.3)',
    icon: 'bi-mortarboard-fill'
  },
  'ppk-ormawa-segara': {
    text: '#34d399',
    bg: 'rgba(52, 211, 153, 0.12)',
    border: 'rgba(52, 211, 153, 0.3)',
    icon: 'bi-award-fill'
  }
};
---

<section id="data-projects" class="data-projects-section">
  <!-- Atmospheric Glow Backdrop -->
  <div class="section-glow" aria-hidden="true"></div>

  <div class="container section-container">
    <!-- Section Header -->
    <div class="section-header fade-in">
      <h2 class="section-title">
        Bukti Nyata & <span class="highlight-text">Portofolio Riset Data</span>
      </h2>
      <p class="section-subtitle">
        Seluruh proyek di bawah ini didasarkan pada naskah ilmiah kompetisi nasional, proposal hibah riset kementerian, dan dokumen resmi yang tersimpan di Google Drive.
      </p>
    </div>

    <!-- Evidence Case Studies Cards (Clean Text & Dossier Layout, No Photos) -->
    <div class="evidence-cards-list">
      {projects.map((proj, pIdx) => {
        const theme = categoryThemes[proj.id] || {
          text: '#38bdf8',
          bg: 'rgba(56, 189, 248, 0.12)',
          border: 'rgba(56, 189, 248, 0.3)',
          icon: 'bi-bookmark-star-fill'
        };
        return (
        <article class="evidence-card slide-up" id={proj.id} data-project-idx={pIdx}>
          <div class="dossier-wrapper">
            
            <!-- Meta Pill Bar -->
            <div class="dossier-top-meta">
              <span class="category-tag" style={`color: ${theme.text}; background: ${theme.bg}; border-color: ${theme.border};`}>
                <i class={`bi ${theme.icon}`}></i>
                {proj.category}
              </span>
              <span class="status-verified-badge">
                <i class="bi bi-file-earmark-pdf-fill"></i>
                {proj.badge}
              </span>
              <span class="period-text">
                <i class="bi bi-calendar3"></i>
                {proj.period}
              </span>
            </div>

            <!-- Title, Subtitle & Partner -->
            <h3 class="dossier-title">{proj.title}</h3>
            <p class="dossier-subtitle">{proj.subtitle}</p>
            
            <div class="dossier-partner-row">
              <i class="bi bi-building"></i>
              <span><strong>Mitra & Penyelenggara:</strong> {proj.partner}</span>
            </div>

            <!-- Executive Summary -->
            {proj.summary && (
              <div class="dossier-summary-box">
                <i class="bi bi-info-circle-fill"></i>
                <p>{proj.summary}</p>
              </div>
            )}

            <!-- Authentic Evidence Checklist (Points of Proof) -->
            {proj.evidencePoints && proj.evidencePoints.length > 0 && (
              <div class="evidence-checklist-block">
                <h4 class="checklist-heading">
                  <i class="bi bi-card-checklist"></i> POIN BUKTI & LEGALITAS OPERASIONAL
                </h4>
                <ul class="checklist-items">
                  {proj.evidencePoints.map((point) => (
                    <li class="checklist-item">
                      <i class="bi bi-check-circle-fill check-icon"></i>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Impact Metrics Grid -->
            {proj.metrics && proj.metrics.length > 0 && (
              <div class="dossier-metrics-grid">
                {proj.metrics.map((m) => (
                  <div class="metric-card">
                    <span class="metric-number">{m.value}</span>
                    <span class="metric-desc">{m.label}</span>
                  </div>
                ))}
              </div>
            )}

            <!-- Tech Stack Chips -->
            {proj.techStack && proj.techStack.length > 0 && (
              <div class="dossier-tech-row">
                <span class="tech-row-lbl">Alat & Teknologi:</span>
                <div class="tech-tags-list">
                  {proj.techStack.map((tech) => (
                    <span class="tech-badge">
                      <i class="bi bi-code-slash"></i>
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <!-- Action & Verification Links -->
            <div class="dossier-actions-row">
              {proj.docsUrl && (
                <a
                  href={proj.docsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-evidence btn-docs"
                  title="Buka Berkas Bukti Resmi di Google Drive"
                >
                  <i class="bi bi-google"></i>
                  <span>Buka Berkas Bukti (Google Drive)</span>
                  <i class="bi bi-box-arrow-up-right external-icon"></i>
                </a>
              )}

              {proj.liveUrl && (
                <a
                  href={proj.liveUrl}
                  target={proj.liveUrl.startsWith('http') ? "_blank" : undefined}
                  rel={proj.liveUrl.startsWith('http') ? "noopener noreferrer" : undefined}
                  class="btn-evidence btn-live"
                  title="Kunjungi Aplikasi Web Live"
                >
                  <i class="bi bi-globe2"></i>
                  <span>{proj.id === 'agrialert-satria-data' ? 'Buka Aplikasi AgriAlert (Live PWA)' : 'Kunjungi Aplikasi Web'}</span>
                  {proj.liveUrl.startsWith('http') && <i class="bi bi-box-arrow-up-right external-icon"></i>}
                </a>
              )}

              {proj.githubUrl && (
                <a
                  href={proj.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-evidence btn-github"
                  title="Lihat Repositori Kode Sumber di GitHub"
                >
                  <i class="bi bi-github"></i>
                  <span>Repositori GitHub</span>
                  <i class="bi bi-box-arrow-up-right external-icon"></i>
                </a>
              )}
            </div>

          </div>
        </article>
      );
      })}
    </div>
  </div>
</section>

<style>
  .data-projects-section {
    position: relative;
    background-color: var(--color-charcoal, #141416);
    color: var(--color-white, #ffffff);
    padding: 6.5rem 6%;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .section-glow {
    position: absolute;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 750px;
    height: 420px;
    background: radial-gradient(circle, rgba(200, 157, 86, 0.12) 0%, rgba(20, 20, 22, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  .section-container {
    max-width: 1140px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Header */
  .section-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 3.5rem;
  }



  .section-title {
    font-family: var(--font-serif, var(--font-serif, "Gambarino", Georgia, serif));
    font-size: clamp(2rem, 3.8vw, 2.75rem);
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .highlight-text {
    color: var(--color-gold, #c89d56);
    font-style: italic;
  }



  .section-subtitle {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #cbd5e1;
  }

  /* Evidence Cards List */
  .evidence-cards-list {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  .evidence-card {
    background: var(--color-midnight, #111827);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 2.5rem 2.75rem;
    box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.5);
    position: relative;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .evidence-card:hover {
    border-color: rgba(200, 157, 86, 0.45);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
    transform: translateY(-2px);
  }

  .dossier-wrapper {
    display: flex;
    flex-direction: column;
  }

  /* Meta Bar */
  .dossier-top-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .category-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: #38bdf8;
    padding: 0.28rem 0.75rem;
    border-radius: 6px;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .status-verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(200, 157, 86, 0.12);
    border: 1px solid rgba(200, 157, 86, 0.35);
    color: var(--color-gold, #c89d56);
    padding: 0.28rem 0.75rem;
    border-radius: 6px;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .period-text {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.82rem;
    margin-left: auto;
  }

  /* Titles */
  .dossier-title {
    font-family: var(--font-serif, var(--font-serif, "Gambarino", Georgia, serif));
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    line-height: 1.3;
    color: #ffffff;
    margin-bottom: 0.45rem;
  }

  .dossier-subtitle {
    font-size: 0.98rem;
    color: var(--color-gold, #c89d56);
    font-weight: 600;
    margin-bottom: 0.85rem;
  }

  .dossier-partner-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 1.25rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dossier-partner-row strong {
    color: #ffffff;
  }

  /* Summary Box */
  .dossier-summary-box {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: rgba(18, 19, 22, 0.65);
    border: 1px solid rgba(200, 157, 86, 0.25);
    padding: 1rem 1.25rem;
    border-radius: 12px;
    margin-bottom: 1.5rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
  }

  .dossier-summary-box i {
    color: var(--color-gold, #c89d56);
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  /* Checklist Block */
  .evidence-checklist-block {
    background: rgba(18, 19, 22, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.25rem 1.4rem;
    margin-bottom: 1.5rem;
  }

  .checklist-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold, #c89d56);
    margin-bottom: 0.9rem;
  }

  .checklist-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .checklist-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.84);
  }

  .check-icon {
    color: #10b981;
    font-size: 1rem;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  /* Metrics Grid */
  .dossier-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .metric-card {
    background: rgba(18, 19, 22, 0.75);
    border: 1px solid rgba(200, 157, 86, 0.25);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .metric-card:hover {
    border-color: rgba(200, 157, 86, 0.5);
    background: rgba(24, 26, 32, 0.9);
    transform: translateY(-1px);
  }

  .metric-number {
    font-family: var(--font-serif, var(--font-serif, "Gambarino", Georgia, serif));
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-gold, #c89d56);
    margin-bottom: 0.25rem;
  }

  .metric-desc {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.3;
  }

  /* Tech Stack */
  .dossier-tech-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.75rem;
    padding-top: 0.5rem;
  }

  .tech-row-lbl {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.6);
  }

  .tech-tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #e2e8f0;
    font-size: 0.76rem;
    font-weight: 600;
    padding: 0.28rem 0.65rem;
    border-radius: 6px;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .tech-badge:hover {
    background: rgba(197, 168, 128, 0.1);
    border-color: rgba(197, 168, 128, 0.35);
    color: #ffffff;
  }

  .tech-badge i {
    color: var(--color-gold, #c89d56);
  }

  /* Action Buttons Row */
  .dossier-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .btn-evidence {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-evidence:focus-visible {
    outline: 2px solid var(--color-gold, #c89d56);
    outline-offset: 2px;
  }

  .btn-docs {
    background: rgba(200, 157, 86, 0.16);
    border: 1px solid rgba(200, 157, 86, 0.5);
    color: var(--color-gold, #c89d56);
  }

  .btn-docs:hover {
    background: var(--color-gold, #c89d56);
    color: #0d0e10;
  }

  .btn-live {
    background: rgba(16, 185, 129, 0.16);
    border: 1px solid rgba(16, 185, 129, 0.5);
    color: #34d399;
  }

  .btn-live:hover {
    background: #10b981;
    color: #0d0e10;
  }

  .btn-github {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
  }

  .btn-github:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .external-icon {
    font-size: 0.74rem;
    opacity: 0.75;
  }

  /* Touch Target & Fluid Action Layout */
  .btn-evidence {
    min-height: 44px;
  }

  /* Responsive Breakpoints & Fluid Spatial Rhythm */
  @media (max-width: 860px) {
    .dossier-metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .evidence-card {
      padding: 1.75rem 1.35rem;
    }
    .dossier-top-meta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.55rem;
    }
    .period-text {
      width: 100%;
      margin-left: 0;
      margin-top: 0.25rem;
    }
    .dossier-actions-row {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-evidence {
      justify-content: center;
    }
  }

  @media (max-width: 440px) {
    .dossier-metrics-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Motion Accessibility: Graceful Reduced Motion Handling */
  @media (prefers-reduced-motion: reduce) {
    .evidence-card, .btn-evidence, .metric-card, .tech-badge {
      transition: opacity 0.1s ease, border-color 0.1s ease !important;
      transform: none !important;
    }
    .evidence-card:hover, .metric-card:hover, .btn-evidence:hover {
      transform: none !important;
    }
  }
</style>
