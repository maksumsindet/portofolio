---
// DataProjects.astro
// Showcase Berkas Proyek Data & Riset Akademik Resmi (Sesuai Arsip Google Drive)
// Distilled Editorial Dossier: Zero Box-in-Box Nesting, Seamless Metrics Strip, Clear Action Hierarchy
import { dataProjects } from '../data/portfolioData';

const projects = dataProjects?.projects || [];

const categoryThemes: Record<string, { text: string; bg: string; icon: string }> = {
  'agrialert-satria-data': {
    text: 'var(--color-domain-sky, #38bdf8)',
    bg: 'rgba(56, 189, 248, 0.12)',
    icon: 'bi-broadcast-pin'
  },
  'gemastik-lda-umkm': {
    text: 'var(--color-domain-violet, #a78bfa)',
    bg: 'rgba(167, 139, 250, 0.12)',
    icon: 'bi-diagram-3-fill'
  },
  'pkm-rsh-ai-literacy': {
    text: 'var(--color-domain-amber, #fb923c)',
    bg: 'rgba(251, 146, 60, 0.12)',
    icon: 'bi-mortarboard-fill'
  },
  'ppk-ormawa-segara': {
    text: 'var(--color-domain-emerald, #34d399)',
    bg: 'rgba(52, 211, 153, 0.12)',
    icon: 'bi-award-fill'
  }
};
---

<section id="data-projects" class="data-projects-section">
  <div class="container section-container">
    <!-- Section Header -->
    <div class="section-header fade-in">
      <div class="accent-lead-wrap">
        <span class="accent-rule"></span>
        <span class="lead-phrase">Bukti Ilmiah & Rekam Jejak Riset</span>
        <span class="accent-rule"></span>
      </div>
      <h2 class="section-title">
        Portofolio Riset & <span class="highlight-text">Proyek Data Teruji</span>
      </h2>
      <p class="section-subtitle">
        Naskah ilmiah kompetisi nasional, proposal hibah riset kementerian, dan implementasi aplikasi berbasis dokumen resmi.
      </p>
    </div>

    <!-- Distilled Editorial Dossier Cards -->
    <div class="evidence-cards-list">
      {projects.map((proj, pIdx) => {
        const theme = categoryThemes[proj.id] || {
          text: 'var(--color-domain-sky, #38bdf8)',
          bg: 'rgba(56, 189, 248, 0.12)',
          icon: 'bi-bookmark-star-fill'
        };
        const hasLiveApp = !!proj.liveUrl;

        return (
          <article class="evidence-card slide-up" id={proj.id} data-project-idx={pIdx}>
            <!-- Top Metadata Strip -->
            <div class="dossier-meta-row">
              <span class="category-badge" style={`color: ${theme.text}; background: ${theme.bg};`}>
                <i class={`bi ${theme.icon}`} aria-hidden="true"></i>
                <span>{proj.category}</span>
              </span>
              <span class="badge-separator" aria-hidden="true">/</span>
              <span class="verified-document-code">
                <i class="bi bi-file-earmark-check-fill" aria-hidden="true"></i>
                <span>{proj.badge}</span>
              </span>
              <span class="period-pill">
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                <span>{proj.period}</span>
              </span>
            </div>

            <!-- Title & Institution -->
            <h3 class="dossier-title">{proj.title}</h3>
            
            <div class="dossier-partner">
              <i class="bi bi-building" aria-hidden="true"></i>
              <span>{proj.partner}</span>
            </div>

            <!-- Editorial Lead Summary (No nested card container) -->
            {proj.summary && (
              <p class="dossier-lead-summary">{proj.summary}</p>
            )}

            <!-- Flat Seamless Metrics Strip -->
            {proj.metrics && proj.metrics.length > 0 && (
              <div class="dossier-metrics-strip" aria-label="Metrik Dampak Proyek">
                {proj.metrics.map((m) => (
                  <div class="metric-item">
                    <span class="metric-val">{m.value}</span>
                    <span class="metric-lbl">{m.label}</span>
                  </div>
                ))}
              </div>
            )}

            <!-- Key Proof Points -->
            {proj.evidencePoints && proj.evidencePoints.length > 0 && (
              <div class="dossier-proof-section">
                <div class="proof-heading">Sorotan & Pembuktian Ilmiah</div>
                <ul class="proof-list">
                  {proj.evidencePoints.map((point) => (
                    <li class="proof-item">
                      <i class="bi bi-check2 check-icon" aria-hidden="true"></i>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Tech Stack Pills -->
            {proj.techStack && proj.techStack.length > 0 && (
              <div class="dossier-tech-strip">
                <span class="tech-label">Alat & Teknologi:</span>
                <div class="tech-pills">
                  {proj.techStack.map((tech) => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>
              </div>
            )}

            <!-- Action Hierarchy (Primary Gold vs Clean Secondary) -->
            <div class="dossier-actions-row">
              {hasLiveApp ? (
                <>
                  <a
                    href={proj.liveUrl}
                    target={proj.liveUrl.startsWith('http') ? "_blank" : undefined}
                    rel={proj.liveUrl.startsWith('http') ? "noopener noreferrer" : undefined}
                    class="btn-primary-action btn-gold"
                    aria-label={`Buka Aplikasi Web ${proj.title}`}
                  >
                    <i class="bi bi-globe2" aria-hidden="true"></i>
                    <span>{proj.id === 'agrialert-satria-data' ? 'Buka Aplikasi AgriAlert (Live PWA)' : 'Kunjungi Aplikasi Web'}</span>
                    {proj.liveUrl.startsWith('http') && <i class="bi bi-box-arrow-up-right external-icon" aria-hidden="true"></i>}
                  </a>

                  {proj.docsUrl && (
                    <a
                      href={proj.docsUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-secondary-action"
                      aria-label={`Buka Berkas Bukti Resmi di Google Drive untuk ${proj.title}`}
                    >
                      <i class="bi bi-google" aria-hidden="true"></i>
                      <span>Berkas Google Drive</span>
                      <i class="bi bi-box-arrow-up-right external-icon" aria-hidden="true"></i>
                    </a>
                  )}

                  {proj.githubUrl && (
                    <a
                      href={proj.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-secondary-action"
                      aria-label={`Lihat Repositori Kode Sumber di GitHub untuk ${proj.title}`}
                    >
                      <i class="bi bi-github" aria-hidden="true"></i>
                      <span>Repositori GitHub</span>
                      <i class="bi bi-box-arrow-up-right external-icon" aria-hidden="true"></i>
                    </a>
                  )}
                </>
              ) : (
                proj.docsUrl && (
                  <a
                    href={proj.docsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary-action btn-gold"
                    aria-label={`Buka Berkas Bukti Resmi di Google Drive untuk ${proj.title}`}
                  >
                    <i class="bi bi-google" aria-hidden="true"></i>
                    <span>Buka Berkas Bukti Resmi (Google Drive)</span>
                    <i class="bi bi-box-arrow-up-right external-icon" aria-hidden="true"></i>
                  </a>
                )
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .data-projects-section {
    position: relative;
    background-color: var(--color-midnight-deep, #0B101B);
    padding: 6.5rem 6%;
    color: var(--color-text-light, #F8FAFC);
  }

  .section-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  /* Section Header */
  .section-header {
    margin-bottom: 4rem;
    text-align: center;
  }

  .accent-lead-wrap {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .accent-rule {
    width: 28px;
    height: 1px;
    background-color: var(--color-gold, #C5A880);
  }

  .lead-phrase {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-gold, #C5A880);
    text-transform: uppercase;
  }

  .section-title {
    font-family: var(--font-serif, 'Gambarino', Georgia, serif);
    font-size: clamp(2rem, 3.2vw, 2.85rem);
    font-weight: 400;
    line-height: 1.18;
    color: #FFFFFF;
    margin-bottom: 1rem;
    letter-spacing: -0.015em;
  }

  .highlight-text {
    color: var(--color-gold, #C5A880);
    font-style: italic;
  }

  .section-subtitle {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-muted-light, #CBD5E1);
    max-width: 760px;
    margin: 0 auto;
  }

  /* Distilled Evidence Cards List */
  .evidence-cards-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* Monolithic Editorial Slab (Zero box-in-box nesting) */
  .evidence-card {
    background-color: var(--color-midnight-card, #182234);
    border: 1px solid var(--color-midnight-border, #23314B);
    border-radius: 12px;
    padding: clamp(1.75rem, 3.5vw, 3rem);
    box-sizing: border-box;
    transition: border-color 0.25s ease;
  }

  .evidence-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
  }

  /* Meta Row */
  .dossier-meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
    font-size: 0.84rem;
  }

  .category-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .badge-separator {
    color: var(--color-midnight-border, #23314B);
    user-select: none;
  }

  .verified-document-code {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-gold, #C5A880);
    font-family: monospace;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .period-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-secondary, #526071);
    font-size: 0.82rem;
    margin-left: auto;
  }

  /* Title & Institution */
  .dossier-title {
    font-family: var(--font-serif, 'Gambarino', Georgia, serif);
    font-size: clamp(1.35rem, 2.1vw, 1.85rem);
    font-weight: 400;
    line-height: 1.28;
    color: #FFFFFF;
    margin-bottom: 0.85rem;
    letter-spacing: -0.01em;
  }

  .dossier-partner {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-gold, #C5A880);
    font-size: 0.92rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .dossier-partner i {
    font-size: 1rem;
    flex-shrink: 0;
  }

  /* Editorial Lead Summary */
  .dossier-lead-summary {
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--color-text-muted-light, #CBD5E1);
    margin-bottom: 2rem;
    max-width: 95ch;
    text-align: justify;
    text-justify: inter-word;
  }

  /* Flat Seamless Metrics Strip */
  .dossier-metrics-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding: 1.4rem 0;
    margin-bottom: 2.2rem;
    border-top: 1px solid var(--color-midnight-border, #23314B);
    border-bottom: 1px solid var(--color-midnight-border, #23314B);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-val {
    font-family: var(--font-serif, 'Gambarino', Georgia, serif);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .metric-lbl {
    font-size: 0.82rem;
    color: var(--color-text-muted-light, #CBD5E1);
    line-height: 1.45;
  }

  /* Key Proof Points */
  .dossier-proof-section {
    margin-bottom: 2rem;
  }

  .proof-heading {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary, #526071);
    margin-bottom: 0.85rem;
  }

  .proof-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .proof-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--color-text-muted-light, #CBD5E1);
  }

  .check-icon {
    color: var(--color-gold, #C5A880);
    font-size: 1.15rem;
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* Tech Stack */
  .dossier-tech-strip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.2rem;
  }

  .tech-label {
    font-size: 0.82rem;
    color: var(--color-text-secondary, #526071);
    font-weight: 600;
  }

  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tech-tag {
    font-size: 0.78rem;
    color: var(--color-text-muted-light, #CBD5E1);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    font-weight: 500;
  }

  /* Action Hierarchy */
  .dossier-actions-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-midnight-border, #23314B);
  }

  .btn-primary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.4rem;
    min-height: 44px; /* Impeccable touch target floor */
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease;
    box-sizing: border-box;
  }

  .btn-primary-action:hover {
    transform: translateY(-2px);
  }

  .btn-secondary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.25rem;
    min-height: 44px; /* Impeccable touch target floor */
    border-radius: 6px;
    font-weight: 500;
    font-size: 0.88rem;
    color: var(--color-text-muted-light, #CBD5E1);
    background: transparent;
    border: 1px solid var(--color-midnight-border, #23314B);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    box-sizing: border-box;
  }

  .btn-secondary-action:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--color-gold, #C5A880);
    color: #FFFFFF;
  }

  .external-icon {
    font-size: 0.8rem;
    opacity: 0.8;
  }

  .btn-primary-action:focus-visible,
  .btn-secondary-action:focus-visible {
    outline: 2px solid var(--color-gold, #C5A880);
    outline-offset: 2px;
  }

  /* Responsive Rules */
  @media (max-width: 900px) {
    .dossier-metrics-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 600px) {
    .dossier-metrics-strip {
      grid-template-columns: 1fr;
    }
    .period-pill {
      margin-left: 0;
      width: 100%;
    }
    .dossier-actions-row {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-primary-action,
    .btn-secondary-action {
      justify-content: center;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .evidence-card,
    .btn-primary-action,
    .btn-secondary-action {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
