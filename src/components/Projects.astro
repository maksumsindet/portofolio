---

<section id="projects" class="projects-section">
  <div class="projects-header-container">
    <div class="section-title fade-in">
      <h2>Dokumentasi Lapangan</h2>
    </div>
  </div>

  <!-- Dual Row Continuous Photo Marquee -->
  <div class="marquee-showcase-wrap slide-up">
    <!-- Row 1: Moves to the Left -->
    <div class="marquee-row marquee-row-top" aria-label="Galeri kegiatan baris atas bergerak ke kiri">
      <div class="marquee-track marquee-track-left">
        {row1Photos.concat(row1Photos).map((item) => (
          <div class="marquee-item">
            <img
              src={item.src}
              alt={item.alt}
              width="340"
              height="220"
              loading="lazy"
              class="marquee-img"
            />
            <span class="marquee-caption">{item.caption}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Row 2: Moves to the Right -->
    <div class="marquee-row marquee-row-bottom" aria-label="Galeri kegiatan baris bawah bergerak ke kanan">
      <div class="marquee-track marquee-track-right">
        {row2Photos.concat(row2Photos).map((item) => (
          <div class="marquee-item">
            <img
              src={item.src}
              alt={item.alt}
              width="340"
              height="220"
              loading="lazy"
              class="marquee-img"
            />
            <span class="marquee-caption">{item.caption}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

</section>

<style>
  .section-title {
    margin-bottom: 3.5rem;
  }

  .projects-section {
    background-color: var(--color-cream);
    padding: 6.5rem 0 5.5rem;
    position: relative;
    overflow: hidden;
  }

  .projects-header-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 6%;
  }

  /* Dual Row Marquee */
  .marquee-showcase-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    position: relative;
  }

  .marquee-row {
    width: 100%;
    overflow: hidden;
    position: relative;
    display: flex;
  }

  .marquee-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    will-change: transform;
  }

  /* Row 1 moves to the left */
  .marquee-track-left {
    animation: scrollMarqueeLeft 40s linear infinite;
  }

  /* Row 2 moves to the right */
  .marquee-track-right {
    animation: scrollMarqueeRight 40s linear infinite;
  }

  .marquee-row:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-item {
    position: relative;
    width: 340px;
    height: 220px;
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--color-cream-subtle);
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .marquee-item:hover {
    transform: scale(1.03);
  }

  .marquee-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  .marquee-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 0.8rem 1rem;
    background-color: rgba(24, 11, 15, 0.85);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .marquee-item:hover .marquee-caption {
    opacity: 1;
    transform: translateY(0);
  }

  /* Animations */
  @keyframes scrollMarqueeLeft {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes scrollMarqueeRight {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track-left,
    .marquee-track-right {
      animation: none;
    }
    .marquee-row {
      overflow-x: auto;
    }
  }

</style>