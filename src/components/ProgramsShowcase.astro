---
// ProgramsShowcase.astro
// Recreates Section 2 of "Bernstein": "Committed to Real Social Action", 2x2 Feature Grid, Overlapping Quote Box, and Executive Program Cards
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

const programs = [
  {
    category: "Pemberdayaan Masyarakat",
    title: "PPK Ormawa SEGARA",
    subtitle: "Sentra Gerak Agromina",
    role: "Ketua Tim Pelaksana",
    description: "Mengembangkan 4 Pilar (Madya, Karya, Daya, Raya): 224 kolam budidaya, hilirisasi olahan IKANURA, aplikasi SEGARA App, & Gapokkan Segara Agung.",
    image: `${base}assets/images/portfolio/uny-dscf0754.jpg`,
    link: "#media",
    tag: "Terbaik 2 Nasional"
  },
  {
    category: "Prestasi & Rekognisi",
    title: "Anugerah Abdidaya Ormawa",
    subtitle: "Kemdiktisaintek RI 2026",
    role: "Terbaik 2 Nasional Tim Pelaksana",
    description: "Penghargaan bergengsi tertinggi Kemdiktisaintek RI di Universitas Muslim Indonesia (UMI) Makassar atas keberhasilan program pemberdayaan 224 kolam.",
    image: `${base}assets/images/portfolio/abdidaya-stage-uny.jpg`,
    link: "#achievements",
    tag: "Juara 2 Nasional"
  },
  {
    category: "Advokasi & Kebijakan",
    title: "Kajian Strategis IHMSI",
    subtitle: "Kajian Nasional Berbasis Data",
    role: "Presidium I Mukernas XIX",
    description: "Mengkaji isu-isu strategis nasional berbasis data statistik dan memimpin persidangan permusyawaratan kerja nasional.",
    image: `${base}assets/images/portfolio/fmipa-ksi1.jpg`,
    link: "#experience",
    tag: "Nasional"
  },
  {
    category: "Riset & Keilmiahan",
    title: "KSI Mist FMIPA UNY",
    subtitle: "Penalaran & Lomba Mahasiswa",
    role: "Kepala Departemen KPL",
    description: "Mengoordinasikan pembinaan delegasi kompetisi ilmiah nasional, monitoring prestasi, dan pendampingan karya tulis.",
    image: `${base}assets/images/portfolio/fmipa-ksi2.jpg`,
    link: "#experience",
    tag: "Departemen KPL"
  }
];

const commitmentPillars = [
  {
    icon: "fas fa-chart-line",
    title: "Analisis Data Terukur",
    desc: "Eksplorasi statistika, komputasi R & Python, serta pemodelan inferensial teruji."
  },
  {
    icon: "fas fa-users",
    title: "Pemberdayaan Komunitas",
    desc: "Penguatan kelembagaan 6 kelompok budidaya dan hilirisasi produk bernilai tambah."
  },
  {
    icon: "fas fa-laptop-code",
    title: "Transformasi Digital",
    desc: "Perancangan SEGARA App teruji keamanan sistem bersama Diskominfo Sleman."
  },
  {
    icon: "fas fa-balance-scale",
    title: "Kajian Kebijakan Strategis",
    desc: "Perumusan rekomendasi kebijakan berbasis bukti data di tingkat mahasiswa nasional."
  }
];

const featurePills = [
  { icon: "fas fa-mobile-alt", label: "SEGARA App (Uji Diskominfo)" },
  { icon: "fas fa-handshake", label: "Kemitraan B2B Pasar Ikan" },
  { icon: "fas fa-store", label: "Pasar Triwulan & Festival UMKM" },
  { icon: "fas fa-trophy", label: "Abdidaya Ormawa 2026" },
];
---

<section id="programs" class="programs-section">
  <div class="programs-container">
    <!-- Part 1: Bernstein Signature "Committed to Your Mission" Split Section -->
    <div class="commitment-split-wrap slide-up">
      <!-- Left Column: Kicker, Heading, Description & 2x2 Grid -->
      <div class="commitment-left">
        <div class="accent-lead-wrap">
          <span class="accent-rule"></span>
          <span class="lead-phrase">Dedikasi Kepemimpinan & Integritas</span>
        </div>

        <h2 class="commitment-heading">
          <span class="heading-dark">KOMITMEN UNTUK</span>
          <span class="heading-gold">Aksi Nyata Berdampak</span>
        </h2>

        <p class="commitment-intro">
          Kami memadukan ketajaman analisis statistika multivariat dengan kepemimpinan lapangan untuk mengorkestrasi kemitraan multi-pihak yang menghasilkan dampak nyata bagi masyarakat.
        </p>

        <div class="commitment-grid-2x2">
          {commitmentPillars.map((pillar) => (
            <div class="pillar-box">
              <div class="pillar-icon-halo">
                <i class={pillar.icon}></i>
              </div>
              <div class="pillar-text">
                <h3 class="pillar-title">{pillar.title}</h3>
                <p class="pillar-desc">{pillar.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Documentary Photo with Overlapping Navy Quote Card -->
      <div class="commitment-right">
        <div class="commitment-visual-frame">
          <div class="visual-img-wrap">
            <img
              src={`${base}assets/images/portfolio/uny-dscf0754.jpg`}
              alt="Pemberdayaan Masyarakat di Kalurahan Sidoagung"
              loading="lazy"
            />
          </div>

          <!-- Overlapping Dark Navy Quote Box (Bernstein Signature Tell) -->
          <div class="quote-callout-card">
            <p class="quote-text">
              "Wawasan data tidak berhenti pada angka di atas kertas, melainkan menjadi kompas aksi nyata yang menggerakkan kemandirian masyarakat."
            </p>
            <div class="quote-author">
              <span class="author-name">Muhammad Dahron M. Maksum</span>
              <span class="author-role">Ketua Tim Pelaksana PPK Ormawa SEGARA</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Part 2: 4 Executive Program Cards -->
    <div class="section-title fade-in" style="margin-top: 6rem; margin-bottom: 3.5rem;">
      <div class="accent-lead-wrap" style="justify-content: center;">
        <span class="accent-rule"></span>
        <span class="lead-phrase">Pilar Inisiatif Perubahan</span>
        <span class="accent-rule"></span>
      </div>
      <h2>Program Unggulan Teruji</h2>
    </div>

    <div class="program-cards-grid">
      {programs.map((item) => (
        <div class="program-card slide-up">
          <div class="card-media-box">
            <img src={item.image} alt={item.title} class="card-photo" loading="lazy" />
            <span class="card-badge">{item.tag}</span>
          </div>
          
          <div class="card-body">
            <div class="card-meta">
              <span class="card-category">{item.category}</span>
            </div>
            <h3 class="card-title">{item.title}</h3>
            <p class="card-role">{item.role}</p>
            <p class="card-desc">{item.description}</p>
            
            <div class="card-footer">
              <a href={item.link} class="card-link">
                <span>Eksplorasi Detail</span>
                <i class="fas fa-arrow-right"></i>
              </a>
              <a href={item.link} class="btn-circle" aria-label={`Detail ${item.title}`}>
                <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Part 3: Wide Showcase Card with Split Layout & Gold Metric Numbers -->
    <div class="cinematic-showcase slide-up">
      <div class="cinematic-card-inner">
        <div class="cinematic-grid">
          <!-- Left Column: Impact Content -->
          <div class="cinematic-content">
            <div class="accent-lead-wrap">
              <span class="accent-rule"></span>
              <span class="lead-phrase">Turn Insight Into Action</span>
            </div>
            <h3 class="cinematic-heading">
              Mengubah Wawasan Menjadi <span class="headline-gold">Aksi Nyata</span>
            </h3>
            <p class="cinematic-sub">
              Kolaborasi strategis multi-pihak antara Ormawa, FMIPA UNY, Pemkab Sleman, dan 20 Dinas dalam menggerakkan potensi lokal perikanan Kalurahan Sidoagung.
            </p>

            <div class="cinematic-metrics-row">
              <div class="cinematic-stat">
                <span class="stat-number">224</span>
                <span class="stat-label">Kolam Budidaya</span>
              </div>
              <div class="cinematic-stat">
                <span class="stat-number">20+</span>
                <span class="stat-label">Dinas Terlibat</span>
              </div>
              <div class="cinematic-stat">
                <span class="stat-number">4 Pilar</span>
                <span class="stat-label">Sentra SEGARA</span>
              </div>
            </div>

            <div class="cinematic-cta-wrap">
              <a
                href="https://drive.google.com/drive/folders/1H6HgFSFGwxvSwdGxksj6OziAQxvSrjA0?usp=drive_link"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-gold"
              >
                <i class="fas fa-folder-open"></i>
                <span>Buka Dokumentasi & Galeri Proyek</span>
                <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>

          <!-- Right Column: Prominent, Crisp, Unobscured Documentary Photo -->
          <div class="cinematic-photo-col">
            <div class="photo-display-frame">
              <img
                src={`${base}assets/images/portfolio/segara-banner-sidoagung.jpg`}
                alt="Dokumentasi Sinergi Multi-Pihak Program SEGARA di Balai Kalurahan Sidoagung"
                class="cinematic-photo"
                loading="lazy"
              />
              <div class="photo-badge">
                <i class="fas fa-camera"></i>
                <span>Dokumentasi Resmi SEGARA Sidoagung</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating Pills at Bottom of Cinematic Card -->
        <div class="cinematic-pills-bar">
          <span class="listen-label">SOROTAN PROGRAM:</span>
          <div class="pills-scroll">
            {featurePills.map((pill) => (
              <span class="feature-pill">
                <i class={pill.icon}></i>
                <span>{pill.label}</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .programs-section {
    background-color: var(--color-cream);
    padding: 7rem 6%;
    position: relative;
    overflow: hidden;
  }

  .programs-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 5;
  }

  /* Part 1: Bernstein Split Section */
  .commitment-split-wrap {
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    gap: 4.5rem;
    align-items: center;
    margin-bottom: 4rem;
  }

  .commitment-heading {
    font-size: var(--step-head);
    line-height: 1.05;
    margin-bottom: 1.4rem;
    display: flex;
    flex-direction: column;
  }

  .heading-dark {
    color: var(--color-text-dark);
    font-weight: 400;
  }

  .heading-gold {
    color: var(--color-gold);
    font-style: italic;
    font-weight: 400;
  }

  .commitment-intro {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 2.5rem;
    max-width: 620px;
  }

  .commitment-grid-2x2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.8rem;
  }

  .pillar-box {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
  }

  .pillar-icon-halo {
    width: 48px;
    height: 48px;
    border-radius: 4px;
    background: #141C2B;
    border: none;
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .pillar-title {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    color: var(--color-text-dark);
    line-height: 1.25;
    margin-bottom: 0.35rem;
    font-weight: 600;
  }

  .pillar-desc {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  /* Visual Frame with Overlapping Quote (Bernstein Signature) */
  .commitment-visual-frame {
    position: relative;
    width: 100%;
  }

  .visual-img-wrap {
    width: 100%;
    height: 440px;
    border-radius: 8px;
    overflow: hidden;
    background-color: #141C2B;
  }

  .visual-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    transition: transform 0.6s ease;
  }

  .commitment-visual-frame:hover .visual-img-wrap img {
    transform: scale(1.04);
  }

  .quote-callout-card {
    position: absolute;
    bottom: -30px;
    left: -30px;
    width: 88%;
    background-color: var(--color-midnight-deep);
    border: none;
    border-radius: 6px;
    padding: 1.8rem 1.6rem;
    color: #ffffff;
    z-index: 5;
  }

  .quote-text {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.6;
    color: #F8FAFC;
    margin-bottom: 1rem;
    font-style: italic;
  }

  .quote-author {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-gold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .author-role {
    font-size: 0.78rem;
    color: var(--color-text-muted-light);
  }

  /* Part 2: 4 Program Cards */
  .program-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem;
    margin-bottom: 5.5rem;
  }

  .program-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: #0B101B;
    border: none;
    display: flex;
    flex-direction: column;
    min-height: 520px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .program-card:hover {
    transform: translateY(-6px);
  }

  .card-media-box {
    position: relative;
    width: 100%;
    height: 220px;
    background-color: #141C2B;
    overflow: hidden;
  }

  .card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    transition: transform 0.45s ease;
  }

  .program-card:hover .card-photo {
    transform: scale(1.05);
  }

  .card-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--color-gold);
    color: #0B101B;
  }

  .card-body {
    padding: 1.6rem 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    background: #0B101B;
    color: #ffffff;
  }

  .card-meta {
    margin-bottom: 0.4rem;
  }

  .card-category {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-gold);
    letter-spacing: 0.04em;
    display: block;
    text-transform: uppercase;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.2;
    margin-bottom: 0.35rem;
    color: #ffffff;
    font-weight: 400;
  }

  .card-role {
    font-size: 0.88rem;
    color: var(--color-gold);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .card-desc {
    font-size: 0.86rem;
    line-height: 1.55;
    color: #CBD5E1;
    margin-bottom: 1.4rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    margin-top: auto;
  }

  .card-link {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s ease;
  }

  .card-link:hover {
    color: var(--color-gold);
  }

  /* Part 3: Wide Showcase Card */
  .cinematic-showcase {
    position: relative;
    margin-top: 2rem;
  }

  .cinematic-card-inner {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: #0B101B;
    border: none;
  }

  .cinematic-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: 2.5rem;
    align-items: center;
    padding: 3.5rem 3.5rem 2.5rem;
  }

  .cinematic-content {
    color: #ffffff;
  }

  .cinematic-heading {
    font-size: 2.4rem;
    line-height: 1.1;
    margin-bottom: 1.1rem;
    color: #ffffff;
    font-weight: 400;
  }

  .cinematic-sub {
    font-size: 1.02rem;
    line-height: 1.65;
    color: #CBD5E1;
    margin-bottom: 2rem;
  }

  .cinematic-metrics-row {
    display: flex;
    gap: 2.5rem;
    margin-bottom: 2rem;
  }

  .cinematic-stat {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    color: var(--color-gold);
    line-height: 1;
    font-weight: 600;
  }

  .stat-label {
    font-size: 0.8rem;
    color: #CBD5E1;
    font-weight: 600;
    margin-top: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cinematic-cta-wrap {
    display: flex;
    align-items: center;
  }

  .cinematic-photo-col {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .photo-display-frame {
    position: relative;
    width: 100%;
    height: 340px;
    border-radius: 6px;
    overflow: hidden;
    background-color: #141C2B;
    border: none;
  }

  .cinematic-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
  }

  .photo-display-frame:hover .cinematic-photo {
    transform: scale(1.04);
  }

  .photo-badge {
    position: absolute;
    bottom: 14px;
    left: 14px;
    background: rgba(11, 16, 27, 0.88);
    border: none;
    color: #ffffff;
    padding: 0.4rem 0.9rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .photo-badge i {
    color: var(--color-gold);
  }

  /* Cinematic Pills Bar */
  .cinematic-pills-bar {
    position: relative;
    z-index: 10;
    background: #080D16;
    padding: 1.2rem 3.8rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .listen-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-gold);
    white-space: nowrap;
    letter-spacing: 0.05em;
  }

  .pills-scroll {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .feature-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(197, 168, 128, 0.1);
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-size: 0.85rem;
    color: #ffffff;
    font-weight: 500;
    transition: background-color 0.2s ease;
  }

  .feature-pill i {
    color: var(--color-gold);
  }

  @media (max-width: 1200px) {
    .commitment-split-wrap {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
    .quote-callout-card {
      position: static;
      width: 100%;
      margin-top: 1rem;
    }
    .program-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .cinematic-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2.8rem 2rem 2rem;
    }
    .photo-display-frame {
      height: 280px;
    }
    .cinematic-pills-bar {
      padding: 1.2rem 2rem;
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 650px) {
    .commitment-grid-2x2 {
      grid-template-columns: 1fr;
    }
    .program-cards-grid {
      grid-template-columns: 1fr;
    }
    .programs-section {
      padding-top: 5rem;
    }
    .cinematic-heading {
      font-size: 1.85rem;
    }
    .cinematic-metrics-row {
      flex-wrap: wrap;
      gap: 1.5rem;
    }
    .photo-display-frame {
      height: 220px;
    }
  }
</style>
