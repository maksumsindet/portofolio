---
// ProgramsShowcase.astro
// Recreates "Programs Built for Real Change" & "Turn Insight Into Action" with Taste Skill craftsmanship
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

const programs = [
  {
    category: "Pemberdayaan Masyarakat",
    title: "PPK Ormawa SEGARA",
    subtitle: "Sentra Gerak Agromina",
    role: "Ketua Tim Pelaksana",
    description: "Mengembangkan 4 Pilar (Madya, Karya, Daya, Raya): 224 kolam budidaya, hilirisasi olahan IKANURA, aplikasi SEGARA App, & Gapokkan Segara Agung.",
    image: `${base}assets/images/portfolio/uny-dscf0754.jpg`,
    link: "#media",
    tag: "Terbaik 2 Nasional"
  },
  {
    category: "Prestasi & Rekognisi",
    title: "Anugerah Abdidaya Ormawa",
    subtitle: "Kemdiktisaintek RI 2026",
    role: "Terbaik 2 Nasional Tim Pelaksana",
    description: "Penghargaan bergengsi tertinggi Kemdiktisaintek RI di Universitas Muslim Indonesia (UMI) Makassar atas keberhasilan program pemberdayaan 224 kolam.",
    image: `${base}assets/images/portfolio/abdidaya-stage-uny.jpg`,
    link: "#achievements",
    tag: "Juara 2 Nasional"
  },
  {
    category: "Advokasi & Kebijakan",
    title: "Kajian Strategis IHMSI",
    subtitle: "Kajian Nasional Berbasis Data",
    role: "Presidium I Mukernas XIX",
    description: "Mengkaji isu-isu strategis nasional berbasis data statistik dan memimpin persidangan permusyawaratan kerja nasional.",
    image: `${base}assets/images/portfolio/fmipa-ksi1.jpg`,
    link: "#experience",
    tag: "Nasional"
  },
  {
    category: "Riset & Keilmiahan",
    title: "KSI Mist FMIPA UNY",
    subtitle: "Penalaran & Lomba Mahasiswa",
    role: "Kepala Departemen KPL",
    description: "Mengoordinasikan pembinaan delegasi kompetisi ilmiah nasional, monitoring prestasi, dan pendampingan karya tulis.",
    image: `${base}assets/images/portfolio/fmipa-ksi2.jpg`,
    link: "#experience",
    tag: "Departemen KPL"
  }
];

const featurePills = [
  { icon: "fas fa-mobile-alt", label: "SEGARA App (Uji Diskominfo)" },
  { icon: "fas fa-handshake", label: "Kemitraan B2B Pasar Ikan" },
  { icon: "fas fa-store", label: "Pasar Triwulan & Festival UMKM" },
  { icon: "fas fa-trophy", label: "Abdidaya Ormawa 2026" },
];
---

<section id="programs" class="programs-section">
  <!-- Decorative background elements -->
  <div class="shape-sage-circle deco-circle-top"></div>
  <div class="shape-sage-circle deco-circle-bottom"></div>

  <div class="programs-container">
    <!-- Header: Programs Built for Real Change -->
    <div class="section-title fade-in">
      <h2>Program & Inisiatif Perubahan Nyata</h2>
      <p>
        Inisiatif nyata yang dirancang untuk membangun kemandirian, kepercayaan diri, dan aksi bermakna bagi masyarakat serta komunitas.
      </p>
    </div>

    <!-- 4 Vertical Cards Grid: Photos Fully Visible in Dedicated Top Frames -->
    <div class="program-cards-grid">
      {programs.map((item) => (
        <div class="program-card slide-up">
          <div class="card-media-box">
            <img src={item.image} alt={item.title} class="card-photo" loading="lazy" />
            <span class="card-badge">{item.tag}</span>
          </div>
          
          <div class="card-body">
            <div class="card-meta">
              <span class="card-category">{item.category}</span>
            </div>
            <h3 class="card-title">{item.title}</h3>
            <p class="card-role">{item.role}</p>
            <p class="card-desc">{item.description}</p>
            
            <div class="card-footer">
              <a href={item.link} class="card-link">
                <span>Eksplorasi Detail</span>
                <i class="fas fa-arrow-right"></i>
              </a>
              <a href={item.link} class="btn-circle" aria-label={`Detail ${item.title}`}>
                <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Wide Showcase Card: Turn Insight Into Action with Split Layout & Clear Photo Showcase -->
    <div class="cinematic-showcase slide-up">
      <div class="script-accent-left">
        <span class="font-script">Ideas today<br/>A better tomorrow</span>
      </div>
      <div class="script-accent-right">
        <span class="font-script">Make<br/>Change<br/>Happen</span>
      </div>

      <div class="cinematic-card-inner">
        <div class="cinematic-grid">
          <!-- Left Column: Impact Content -->
          <div class="cinematic-content">
            <div class="script-badge-inline">
              <span class="font-script">Ideas today · A better tomorrow</span>
            </div>
            <h3 class="cinematic-heading">
              Mengubah Wawasan Menjadi <em>Aksi Nyata</em>
            </h3>
            <p class="cinematic-sub">
              Kolaborasi strategis multi-pihak antara Ormawa, FMIPA UNY, Pemkab Sleman, dan 20 Dinas dalam menggerakkan potensi lokal perikanan Kalurahan Sidoagung.
            </p>

            <div class="cinematic-metrics-row">
              <div class="cinematic-stat">
                <span class="stat-number">224</span>
                <span class="stat-label">Kolam Budidaya</span>
              </div>
              <div class="cinematic-stat">
                <span class="stat-number">20+</span>
                <span class="stat-label">Dinas Terlibat</span>
              </div>
              <div class="cinematic-stat">
                <span class="stat-number">4 Pilar</span>
                <span class="stat-label">Sentra SEGARA</span>
              </div>
            </div>

            <div class="cinematic-cta-wrap">
              <a
                href="https://drive.google.com/drive/folders/1H6HgFSFGwxvSwdGxksj6OziAQxvSrjA0?usp=drive_link"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-terracotta"
              >
                <i class="fas fa-folder-open"></i>
                <span>Buka Dokumentasi & Galeri Proyek</span>
                <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>

          <!-- Right Column: Prominent, Crisp, Unobscured Documentary Photo -->
          <div class="cinematic-photo-col">
            <div class="photo-display-frame">
              <img
                src={`${base}assets/images/portfolio/segara-banner-sidoagung.jpg`}
                alt="Dokumentasi Sinergi Multi-Pihak Program SEGARA di Balai Kalurahan Sidoagung"
                class="cinematic-photo"
                loading="lazy"
              />
              <div class="photo-badge">
                <i class="fas fa-camera"></i>
                <span>Dokumentasi Resmi SEGARA Sidoagung</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating Pills at Bottom of Cinematic Card -->
        <div class="cinematic-pills-bar">
          <span class="listen-label">SOROTAN:</span>
          <div class="pills-scroll">
            {featurePills.map((pill) => (
              <span class="feature-pill">
                <i class={pill.icon}></i>
                <span>{pill.label}</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .programs-section {
    background-color: var(--color-cream);
    padding: 6.5rem 6%;
    position: relative;
    overflow: hidden;
  }

  .programs-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 5;
  }

  /* Decorative Organic Circles */
  .deco-circle-top {
    top: 50px;
    right: 4%;
    width: 60px;
    height: 60px;
  }

  .deco-circle-bottom {
    bottom: 80px;
    right: 3%;
    width: 140px;
    height: 140px;
    opacity: 0.6;
  }

  /* 4 Cards Grid */
  .program-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem;
    margin-bottom: 5.5rem;
  }

  .program-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #1c1114;
    display: flex;
    flex-direction: column;
    min-height: 520px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .program-card:hover {
    transform: translateY(-6px);
  }

  /* Dedicated Media Frame on Top (100% Unobscured Photo) */
  .card-media-box {
    position: relative;
    width: 100%;
    height: 230px;
    background-color: #2a171d;
    overflow: hidden;
  }

  .card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    transition: transform 0.45s ease;
  }

  .program-card:hover .card-photo {
    transform: scale(1.05);
  }

  .card-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--color-terracotta);
    color: #ffffff;
  }

  /* Content Body Below Photo */
  .card-body {
    padding: 1.6rem 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    background: #1c1114;
    color: #ffffff;
  }

  .card-meta {
    margin-bottom: 0.4rem;
  }

  .card-category {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-terracotta);
    letter-spacing: 0.04em;
    display: block;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.2;
    margin-bottom: 0.35rem;
    color: #ffffff;
    font-weight: 400;
  }

  .card-role {
    font-size: 0.88rem;
    color: var(--color-terracotta);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .card-desc {
    font-size: 0.86rem;
    line-height: 1.55;
    color: #E2DADB;
    margin-bottom: 1.4rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    margin-top: auto;
  }

  .card-link {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s ease;
  }

  .card-link:hover {
    color: var(--color-terracotta);
  }

  .btn-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--color-terracotta);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .btn-circle:hover {
    background-color: var(--color-terracotta-hover);
    transform: scale(1.08);
  }

  /* Wide Showcase with Split 2-Column Layout */
  .cinematic-showcase {
    position: relative;
    margin-top: 2rem;
  }

  .script-accent-left {
    position: absolute;
    left: -120px;
    top: 30%;
    transform: rotate(-10deg);
    z-index: 15;
    pointer-events: none;
  }

  .script-accent-left span {
    font-size: 2.1rem;
    color: var(--color-text-secondary);
    line-height: 1.1;
  }

  .script-accent-right {
    position: absolute;
    right: -100px;
    top: 25%;
    transform: rotate(8deg);
    z-index: 15;
    pointer-events: none;
  }

  .script-accent-right span {
    font-size: 2.1rem;
    color: var(--color-text-secondary);
    line-height: 1.1;
  }

  .cinematic-card-inner {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: #1e1115;
  }

  .cinematic-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: 2.5rem;
    align-items: center;
    padding: 3.5rem 3.5rem 2.5rem;
  }

  .cinematic-content {
    color: #ffffff;
  }

  .script-badge-inline {
    margin-bottom: 0.8rem;
  }

  .script-badge-inline span {
    font-size: 1.5rem;
    color: var(--color-terracotta);
  }

  .cinematic-heading {
    font-size: 2.4rem;
    line-height: 1.1;
    margin-bottom: 1.1rem;
    color: #ffffff;
    font-weight: 400;
  }

  .cinematic-heading em {
    font-style: italic;
    color: var(--color-terracotta);
  }

  .cinematic-sub {
    font-size: 1.02rem;
    line-height: 1.65;
    color: #DDD4D6;
    margin-bottom: 2rem;
  }

  .cinematic-metrics-row {
    display: flex;
    gap: 2.5rem;
    margin-bottom: 2rem;
  }

  .cinematic-stat {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    color: #ffffff;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--color-terracotta);
    font-weight: 600;
    margin-top: 0.35rem;
  }

  .cinematic-cta-wrap {
    display: flex;
    align-items: center;
  }

  .cinematic-photo-col {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .photo-display-frame {
    position: relative;
    width: 100%;
    height: 340px;
    border-radius: 16px;
    overflow: hidden;
    background-color: #2a171d;
  }

  .cinematic-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
  }

  .photo-display-frame:hover .cinematic-photo {
    transform: scale(1.04);
  }

  .photo-badge {
    position: absolute;
    bottom: 14px;
    left: 14px;
    background: rgba(20, 8, 12, 0.75);
    color: #ffffff;
    padding: 0.4rem 0.9rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Cinematic Pills Bar */
  .cinematic-pills-bar {
    position: relative;
    z-index: 10;
    background: #14080B;
    padding: 1.2rem 3.8rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .listen-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-terracotta);
    white-space: nowrap;
    letter-spacing: 0.05em;
  }

  .pills-scroll {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .feature-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(255, 255, 255, 0.12);
    padding: 0.55rem 1.1rem;
    border-radius: 50px;
    font-size: 0.88rem;
    color: #ffffff;
    font-weight: 500;
    transition: background-color 0.2s ease;
  }

  @media (max-width: 1200px) {
    .script-accent-left, .script-accent-right {
      display: none;
    }
    .program-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .cinematic-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2.8rem 2rem 2rem;
    }
    .photo-display-frame {
      height: 280px;
    }
    .cinematic-pills-bar {
      padding: 1.2rem 2rem;
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 650px) {
    .program-cards-grid {
      grid-template-columns: 1fr;
    }
    .programs-section {
      padding-top: 5rem;
    }
    .cinematic-heading {
      font-size: 1.85rem;
    }
    .cinematic-metrics-row {
      flex-wrap: wrap;
      gap: 1.5rem;
    }
    .photo-display-frame {
      height: 220px;
    }
  }
</style>
