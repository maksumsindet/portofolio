---
// Gallery.astro
import { galleryEmbeds } from '../data/portfolioData';
---

<section id="gallery" class="gallery section">
  <div class="section-title">
    <h2>Galeri</h2>
  </div>
  <div class="gallery-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; max-width: 100%; margin: 0 auto; width: 100%; justify-items: center;">
    {galleryEmbeds.map((embedUrl) => (
      <div class="gallery-item slide-up" style="width: 100%; display: flex; justify-content: center;">
        <iframe
          src={embedUrl}
          width="100%"
          height="560"
          title="Instagram post"
          scrolling="no"
          style="max-width: 400px; display: block; border-radius: 12px; border: 1px solid rgba(0,0,0,0.1); box-shadow: 0 4px 6px rgba(0,0,0,0.05); background: white;"
        ></iframe>
      </div>
    ))}
  </div>
</section>
