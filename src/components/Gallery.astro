---
// Gallery.astro
// Complete Visual Archive & Field Documentation
// Features 101 curated documentary photos across diverse facets of leadership, community, outdoor, and academic achievements
import { documentaryPhotos, galleryEmbeds } from '../data/portfolioData';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

const categories = [
  { id: "all", label: "Semua Dokumentasi" },
  { id: "Kepemimpinan & Organisasi", label: "Kepemimpinan & Organisasi" },
  { id: "Pemberdayaan SEGARA", label: "Pemberdayaan SEGARA" },
  { id: "Inovasi Teknis & Pelatihan", label: "Inovasi & Pelatihan" },
  { id: "Prestasi & Penghargaan", label: "Prestasi & Rekognisi" },
  { id: "Religius & Pramuka", label: "Religius & Pramuka" },
  { id: "Petualangan & Alam Terbuka", label: "Petualangan & Alam" },
  { id: "Media & Berita Acara", label: "Media & Berita Acara" }
];

const categoryCounts = categories.reduce((acc, cat) => {
  acc[cat.id] = cat.id === 'all' 
    ? documentaryPhotos.length 
    : documentaryPhotos.filter(p => p.category === cat.id).length;
  return acc;
}, {} as Record<string, number>);
---

<section id="gallery" class="gallery-section">
  <div class="gallery-container">
    <div class="section-title fade-in">
      <h2>Galeri Dokumentasi &amp; Arsip Visual</h2>
      <p>
        Rekaman visual autentik perjalanan kepemimpinan nasional, pemberdayaan masyarakat di Kalurahan Sidoagung, prestasi sains, kiprah kepramukaan, apresiasi tahfidz, hingga eksplorasi alam terbuka.
      </p>
    </div>

    <!-- Category Filter Buttons -->
    <div class="gallery-filters-wrap slide-up">
      <div class="gallery-filters" role="tablist" aria-label="Kategori Galeri Foto">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`filter-btn ${idx === 0 ? 'active' : ''}`}
            data-filter={cat.id}
          >
            {cat.label} ({categoryCounts[cat.id] || 0})
          </button>
        ))}
      </div>
    </div>

    <!-- Curated Photography Grid -->
    <div class="doc-photo-grid slide-up" id="doc-photo-grid">
      {documentaryPhotos.map((photo, index) => (
        <article
          class="doc-photo-card card-cream"
          data-category={photo.category}
          data-index={index}
        >
          <div
            class="doc-img-wrap"
            tabindex="0"
            role="button"
            aria-label={`Buka pratinjau: ${photo.caption}`}
            data-src={`${base}${photo.src}`}
            data-alt={photo.alt}
            data-caption={photo.caption}
            data-tag={photo.tag}
            data-source={photo.source || ''}
          >
            <img
              src={`${base}${photo.src}`}
              alt={photo.alt}
              width="400"
              height="260"
              loading="lazy"
              class="doc-img"
            />
            <div class="img-zoom-cue">
              <i class="bi bi-zoom-in"></i>
              <span>Perbesar</span>
            </div>
          </div>

          <div class="doc-card-body">
            <div class="doc-meta-row">
              <span class="doc-tag">{photo.tag}</span>
              {photo.source && (
                <span class="doc-source">
                  <i class="bi bi-camera"></i> {photo.source}
                </span>
              )}
            </div>
            <h3 class="doc-caption">{photo.caption}</h3>
          </div>
        </article>
      ))}
    </div>

    <!-- Load More Controls -->
    <div class="load-more-wrap" id="load-more-wrap">
      <button type="button" id="btn-load-more" class="btn-load-more">
        <i class="bi bi-grid-3x3-gap"></i>
        <span id="load-more-text">Tampilkan Semua 101 Dokumentasi</span>
      </button>
      <span class="showing-count-text" id="showing-count-text">Menampilkan 24 dari 101 foto dokumentasi</span>
    </div>

    <!-- Lightbox Modal Dialog -->
    <dialog id="photo-lightbox" class="photo-lightbox" aria-label="Pratinjau Foto Dokumentasi">
      <div class="lightbox-dialog-inner">
        <button type="button" id="lightbox-close" class="lightbox-close-btn" aria-label="Tutup pratinjau">
          <i class="bi bi-x-lg"></i>
        </button>
        <div class="lightbox-media">
          <img id="lightbox-img" src="" alt="" />
        </div>
        <div class="lightbox-details">
          <div class="lightbox-meta">
            <span id="lightbox-tag" class="doc-tag"></span>
            <span id="lightbox-source" class="doc-source"></span>
          </div>
          <p id="lightbox-caption" class="lightbox-caption-text"></p>
        </div>
      </div>
    </dialog>

    <!-- Social Media Embeds Section -->
    <div class="social-showcase-section slide-up">
      <div class="social-header">
        <h3 class="social-subheading">Liputan Media Sosial &amp; Cuplikan Video</h3>
        <p class="social-subdesc">
          Dokumentasi interaktif yang dipublikasikan secara terbuka melalui platform media sosial kegiatan kemahasiswaan dan pengabdian.
        </p>

        <div class="insta-profiles-pills">
          <a href="https://www.instagram.com/mksmetrics/" target="_blank" rel="noopener noreferrer" class="insta-pill">
            <i class="bi bi-instagram"></i>
            <span>@mksmetrics (Personal)</span>
            <i class="bi bi-box-arrow-up-right pill-ext"></i>
          </a>
          <a href="https://www.instagram.com/ppkoksimist.segara/" target="_blank" rel="noopener noreferrer" class="insta-pill">
            <i class="bi bi-instagram"></i>
            <span>@ppkoksimist.segara (PPK Ormawa)</span>
            <i class="bi bi-box-arrow-up-right pill-ext"></i>
          </a>
          <a href="https://www.instagram.com/ksimistfmipauny/" target="_blank" rel="noopener noreferrer" class="insta-pill">
            <i class="bi bi-instagram"></i>
            <span>@ksimistfmipauny (KSI Mist FMIPA)</span>
            <i class="bi bi-box-arrow-up-right pill-ext"></i>
          </a>
        </div>
      </div>

      <div class="gallery-embed-grid">
        {galleryEmbeds.map((embedUrl) => (
          <div class="gallery-embed-wrap card-cream">
            <iframe
              src={embedUrl}
              width="100%"
              height="540"
              title="Dokumentasi aktivitas di media sosial"
              scrolling="no"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              class="instagram-iframe"
            ></iframe>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function setupGallery() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.gallery-filters .filter-btn');
    const photoCards = document.querySelectorAll<HTMLElement>('.doc-photo-card');
    const loadMoreWrap = document.getElementById('load-more-wrap');
    const btnLoadMore = document.getElementById('btn-load-more');
    const loadMoreText = document.getElementById('load-more-text');
    const showingCountText = document.getElementById('showing-count-text');

    let currentFilter = 'all';
    const INITIAL_LIMIT = 24;
    let isExpanded = false;

    function renderCards() {
      let visibleCount = 0;
      let totalMatching = 0;

      photoCards.forEach((card) => {
        const category = card.getAttribute('data-category');
        const matches = currentFilter === 'all' || category === currentFilter;

        if (matches) {
          totalMatching++;
          if (currentFilter === 'all' && !isExpanded && totalMatching > INITIAL_LIMIT) {
            card.style.display = 'none';
          } else {
            card.style.display = 'flex';
            visibleCount++;
          }
        } else {
          card.style.display = 'none';
        }
      });

      // Update button & counter
      if (loadMoreWrap && loadMoreText && showingCountText) {
        if (currentFilter === 'all') {
          loadMoreWrap.style.display = 'flex';
          showingCountText.textContent = `Menampilkan ${visibleCount} dari ${totalMatching} foto dokumentasi`;
          if (isExpanded) {
            loadMoreText.textContent = 'Ciutkan Galeri (Tampilkan 24 Foto)';
          } else {
            loadMoreText.textContent = `Tampilkan Semua ${totalMatching} Dokumentasi`;
          }
        } else {
          loadMoreWrap.style.display = 'none';
        }
      }
    }

    // Initialize first render
    renderCards();

    // 1. Filter buttons functionality
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        currentFilter = btn.getAttribute('data-filter') || 'all';
        renderCards();
      });
    });

    // 2. Load More Toggle
    btnLoadMore?.addEventListener('click', () => {
      isExpanded = !isExpanded;
      renderCards();
      if (!isExpanded) {
        document.getElementById('gallery')?.scrollIntoView({ behavior: 'smooth' });
      }
    });

    // 3. Lightbox Modal
    const lightbox = document.getElementById('photo-lightbox') as HTMLDialogElement | null;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxTag = document.getElementById('lightbox-tag');
    const lightboxSource = document.getElementById('lightbox-source');
    const lightboxClose = document.getElementById('lightbox-close');

    if (!lightbox || !lightboxImg || !lightboxCaption || !lightboxTag || !lightboxSource) return;

    const imgWraps = document.querySelectorAll<HTMLElement>('.doc-img-wrap');

    imgWraps.forEach((wrap) => {
      const openModal = () => {
        const src = wrap.getAttribute('data-src') || '';
        const alt = wrap.getAttribute('data-alt') || '';
        const caption = wrap.getAttribute('data-caption') || '';
        const tag = wrap.getAttribute('data-tag') || '';
        const source = wrap.getAttribute('data-source') || '';

        lightboxImg.src = src;
        lightboxImg.alt = alt;
        lightboxCaption.textContent = caption;
        lightboxTag.textContent = tag;
        lightboxSource.textContent = source ? `Sumber: ${source}` : '';

        lightbox.showModal();
      };

      wrap.addEventListener('click', openModal);
      wrap.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal();
        }
      });
    });

    lightboxClose?.addEventListener('click', () => {
      lightbox.close();
    });

    // Close when clicking outside of dialog content
    lightbox.addEventListener('click', (e) => {
      const rect = lightbox.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        lightbox.close();
      }
    });
  }

  // Initialize on load and on astro page-load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGallery);
  } else {
    setupGallery();
  }
  document.addEventListener('astro:page-load', setupGallery);
</script>

<style>
  .gallery-section {
    background-color: var(--color-cream);
    padding: 6.5rem 6%;
    position: relative;
  }

  .gallery-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  /* Filter Buttons */
  .gallery-filters-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 2.8rem;
  }

  .gallery-filters {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0.5rem;
    background: var(--color-cream-deep);
    border-radius: 999px;
    justify-content: center;
  }

  .filter-btn {
    border: none;
    background: transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 600;
    padding: 0.55rem 1.25rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }

  .filter-btn:hover {
    color: var(--color-burgundy);
    transform: translateY(-1px);
  }

  .filter-btn.active {
    background: var(--color-burgundy);
    color: var(--color-cream);
    box-shadow: 0 4px 12px rgba(47, 23, 29, 0.2);
  }

  /* Curated Photography Grid */
  .doc-photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .doc-photo-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 1.2rem;
    border-radius: 16px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .doc-photo-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
  }

  .doc-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-burgundy);
    cursor: pointer;
  }

  .doc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    transition: transform 0.35s ease;
  }

  .doc-img-wrap:hover .doc-img,
  .doc-img-wrap:focus-visible .doc-img {
    transform: scale(1.05);
  }

  .img-zoom-cue {
    position: absolute;
    bottom: 0.8rem;
    right: 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(47, 23, 29, 0.85);
    color: var(--color-cream);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .doc-img-wrap:hover .img-zoom-cue,
  .doc-img-wrap:focus-visible .img-zoom-cue {
    opacity: 1;
  }

  .doc-card-body {
    padding-top: 1.1rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .doc-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .doc-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--color-cream-deep);
    color: var(--color-burgundy);
    padding: 0.2rem 0.65rem;
    border-radius: 4px;
  }

  .doc-source {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .doc-caption {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--color-text-dark);
    margin: 0;
  }

  /* Load More Controls */
  .load-more-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 5.5rem;
  }

  .btn-load-more {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #0f172a;
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.4);
    padding: 0.85rem 2.2rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-load-more:hover {
    background: #f59e0b;
    color: #05070c;
    border-color: #f59e0b;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(245, 158, 11, 0.3);
  }

  .showing-count-text {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  /* Lightbox Modal */
  .photo-lightbox {
    border: none;
    border-radius: 16px;
    padding: 0;
    max-width: 90vw;
    max-height: 90vh;
    background: var(--color-cream);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
  }

  .photo-lightbox::backdrop {
    background: rgba(11, 16, 27, 0.85);
    backdrop-filter: blur(4px);
  }

  .lightbox-dialog-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    max-width: 860px;
    max-height: 85vh;
  }

  .lightbox-close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: none;
    background: rgba(11, 16, 27, 0.7);
    color: #ffffff;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .lightbox-close-btn:hover {
    background: var(--color-burgundy);
  }

  .lightbox-media {
    background: #080D16;
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 62vh;
    overflow: hidden;
  }

  .lightbox-media img {
    max-width: 100%;
    max-height: 62vh;
    object-fit: contain;
    display: block;
  }

  .lightbox-details {
    padding: 1.4rem 1.8rem;
    background: var(--color-cream);
  }

  .lightbox-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .lightbox-caption-text {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-text-dark);
    line-height: 1.45;
    margin: 0;
  }

  /* Social Showcase */
  .social-showcase-section {
    margin-top: 1.5rem;
  }

  .social-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .social-subheading {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    color: var(--color-text-dark);
    margin-bottom: 0.6rem;
  }

  .social-subdesc {
    color: var(--color-text-secondary);
    font-size: 0.98rem;
    max-width: 620px;
    margin: 0 auto 1.5rem;
  }

  .insta-profiles-pills {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .insta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-cream-deep);
    color: var(--color-burgundy);
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .insta-pill:hover {
    background: var(--color-burgundy);
    color: var(--color-cream);
    transform: translateY(-2px);
  }

  .gallery-embed-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    justify-items: center;
  }

  .gallery-embed-wrap {
    width: 100%;
    max-width: 400px;
    padding: 0.8rem;
    display: flex;
    justify-content: center;
    border-radius: 16px;
  }

  .instagram-iframe {
    border: none;
    border-radius: 12px;
    overflow: hidden;
    width: 100%;
  }

  @media (max-width: 1050px) {
    .doc-photo-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery-embed-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .doc-photo-grid {
      grid-template-columns: 1fr;
    }

    .gallery-embed-grid {
      grid-template-columns: 1fr;
    }

    .gallery-filters {
      border-radius: 12px;
    }

    .filter-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
