---
// Contact.astro
import { personalInfo } from '../data/portfolioData';
---

<section id="contact" class="contact-footer-section">
  <!-- Organic Wave Divider from Cream to Dark Burgundy -->
  <div class="wave-transition">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,32 C360,110 720,0 1080,70 C1260,105 1380,50 1440,32 L1440,120 L0,120 Z" fill="#2F171D"></path>
    </svg>
  </div>

  <div class="contact-footer-inner">
    <div class="contact-content-box slide-up">
      <h2 class="contact-headline">
        Langkah Nyata Menuju Dampak Lebih Luas
      </h2>
      <p class="contact-subtext">
        Saya selalu terbuka untuk mendiskusikan peluang kolaborasi baru, riset analisis data statistik, maupun inisiatif pemberdayaan komunitas yang bermakna.
      </p>

      <div class="contact-cta-buttons">
        <a href={personalInfo.social.email} class="btn-terracotta">
          <i class="bi bi-envelope"></i>
          <span>Kirim Email</span>
          <i class="bi bi-arrow-right"></i>
        </a>
        <a href={personalInfo.social.linkedin} target="_blank" rel="noopener noreferrer" class="btn-outline-light">
          <i class="bi bi-linkedin"></i>
          <span>LinkedIn</span>
        </a>
        <a href={personalInfo.social.instagram} target="_blank" rel="noopener noreferrer" class="btn-outline-light">
          <i class="bi bi-instagram"></i>
          <span>Instagram</span>
        </a>
      </div>

      <div class="script-footer-quote">
        <span class="font-script">Ideas today, a better tomorrow.</span>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-footer-section {
    background-color: var(--color-burgundy);
    position: relative;
    padding-bottom: 3.5rem;
    color: var(--color-text-light);
  }

  .wave-transition {
    position: relative;
    top: -1px;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    background-color: var(--color-cream);
  }

  .wave-transition svg {
    display: block;
    width: 100%;
    height: 70px;
  }

  .contact-footer-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 6% 2rem;
    text-align: center;
    position: relative;
    z-index: 10;
  }

  .contact-headline {
    font-size: var(--step-head);
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 1.4rem;
    font-weight: 400;
  }

  .contact-subtext {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--color-text-muted-light);
    margin-bottom: 2.8rem;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .contact-cta-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .script-footer-quote {
    font-size: 2.2rem;
    color: var(--color-terracotta);
    opacity: 0.9;
    transform: rotate(-3deg);
  }

  @media (max-width: 600px) {
    .contact-cta-buttons {
      flex-direction: column;
      width: 100%;
    }
    .contact-cta-buttons a {
      width: 100%;
      justify-content: center;
    }
  }
</style>
