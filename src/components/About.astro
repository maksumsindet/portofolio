---
// About.astro
// Executive Bernstein style About section
import { personalInfo, aboutData } from '../data/portfolioData';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<section id="about" class="about-section">
  <div class="about-container">
    <div class="section-title fade-in">
      <div class="accent-lead-wrap" style="justify-content: center;">
        <span class="accent-rule"></span>
        <span class="lead-phrase">Profil & Filosofi Kerja</span>
        <span class="accent-rule"></span>
      </div>
      <h2>
        <span class="headline-dark">TENTANG SAYA &</span>
        <span class="headline-gold">Dedikasi Nyata</span>
      </h2>
      <p>
        Menghubungkan ketelitian analisis statistik dengan kepekaan sosial untuk menciptakan dampak yang terukur bagi komunitas dan industri.
      </p>
    </div>

    <div class="about-grid slide-up">
      <!-- Left Card: Bio -->
      <div class="about-bio-card card-cream">
        <h3 class="bio-lead-heading">
          Wawasan Data untuk Solusi Berkelanjutan
        </h3>
        
        <div class="bio-paragraphs">
          {aboutData.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>

        <div class="bio-signature-wrap">
          <div class="sig-text font-script">Muhammad Dahron M. Maksum</div>
          <span class="sig-title">Mahasiswa S1 Statistika UNY | IPK {personalInfo.gpa}</span>
        </div>
      </div>

      <!-- Right Column: Fast Facts & Contact -->
      <div class="about-sidebar">
        <div class="facts-card card-cream">
          <h4 class="sidebar-title"><i class="bi bi-person-badge"></i> Informasi Kontak</h4>
          
          <div class="contact-rows">
            <div class="contact-row">
              <div class="contact-icon-box"><i class="bi bi-geo-alt"></i></div>
              <div class="contact-details">
                <span class="contact-label">Domisili</span>
                <span class="contact-val">{personalInfo.address}</span>
              </div>
            </div>

            <div class="contact-row">
              <div class="contact-icon-box"><i class="bi bi-envelope"></i></div>
              <div class="contact-details">
                <span class="contact-label">Email Resmi</span>
                <a href={personalInfo.social.email} class="contact-val email-link">{personalInfo.email}</a>
              </div>
            </div>

            <div class="contact-row">
              <div class="contact-icon-box"><i class="bi bi-telephone"></i></div>
              <div class="contact-details">
                <span class="contact-label">Telepon / WhatsApp</span>
                <span class="contact-val">{personalInfo.phone}</span>
              </div>
            </div>

            <div class="contact-row">
              <div class="contact-icon-box"><i class="bi bi-bank"></i></div>
              <div class="contact-details">
                <span class="contact-label">Institusi</span>
                <span class="contact-val">{personalInfo.university}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="focus-card card-cream">
          <h4 class="sidebar-title"><i class="bi bi-compass"></i> Fokus Kompetensi</h4>
          <div class="focus-tags">
            <div class="focus-tag">
              <i class="bi bi-pie-chart"></i>
              <span>Statistika Terapan & Pemodelan Data</span>
            </div>
            <div class="focus-tag">
              <i class="bi bi-cpu"></i>
              <span>Machine Learning & Komputasi Python/R</span>
            </div>
            <div class="focus-tag">
              <i class="bi bi-people"></i>
              <span>Pemberdayaan Masyarakat & Transformasi Desa</span>
            </div>
            <div class="focus-tag">
              <i class="bi bi-bank"></i>
              <span>Kajian Strategis & Advokasi Kebijakan</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background-color: var(--color-cream);
    padding: 7rem 6%;
    position: relative;
  }

  .about-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .headline-dark {
    color: var(--color-text-dark);
    font-weight: 400;
  }

  .headline-gold {
    color: var(--color-gold);
    font-style: italic;
    font-weight: 400;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: 2.5rem;
  }

  .about-bio-card {
    padding: 3rem;
    background: #FFFFFF;
    border-radius: 8px;
    border: none;
  }

  .bio-lead-heading {
    font-size: 1.85rem;
    color: var(--color-text-dark);
    line-height: 1.25;
    margin-bottom: 1.5rem;
    font-weight: 400;
  }

  .bio-paragraphs p {
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: 1.4rem;
  }

  .bio-signature-wrap {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
  }

  .sig-text {
    font-size: 2.4rem;
    color: #0B101B;
    line-height: 1.1;
  }

  .sig-title {
    font-size: 0.9rem;
    color: var(--color-gold);
    font-weight: 700;
    display: block;
    margin-top: 0.2rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Sidebar */
  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .facts-card, .focus-card {
    background: #FFFFFF;
    border-radius: 8px;
    border: none;
    padding: 2.2rem;
  }

  .sidebar-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-text-dark);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
  }

  .sidebar-title i {
    color: var(--color-gold);
  }

  .contact-rows {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .contact-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-icon-box {
    width: 42px;
    height: 42px;
    border-radius: 4px;
    background: #141C2B;
    border: none;
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
  }

  .contact-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .contact-val {
    font-size: 0.98rem;
    color: var(--color-text-dark);
    font-weight: 500;
    line-height: 1.4;
    word-break: break-word;
  }

  .email-link {
    text-decoration: none;
    color: #0B101B;
    transition: color 0.2s ease;
  }

  .email-link:hover {
    color: var(--color-gold);
  }

  .focus-tags {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .focus-tag {
    background: #F8FAFC;
    border: none;
    padding: 0.8rem 1.1rem;
    border-radius: 6px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text-dark);
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .focus-tag i {
    color: var(--color-gold);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-bio-card {
      padding: 2.2rem 1.8rem;
    }
  }
</style>
